; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Master Project"
run/main_scene="res://Scenes/Main Menu/Main_Menu.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PlayerVariables="*res://Global Scripts/player_variables.gd"
DbHelper="*res://Global Scripts/DBHelper.gd"
Expressions="*res://Global Scripts/expressions.gd"
SignalBus="*res://Scripts/signalBus.gd"
SteamManager="*res://Scripts/Multiplayer/Steam/steam_manager.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=600

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-sqlite/plugin.cfg")
