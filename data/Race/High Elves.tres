_name = "Silver Tongue"
short_description = "Refined poise turns social missteps into second chances."
long_description = "When you fail a Speech, Society, or Command check, reroll it once. You must use the new result."

[resource]
script = ExtResource("2_s0pvo")
perk = SubResource("Resource_labk4")
_name = "High Elves"
short_description = "Charismatic masters of social influence."
long_description = "High Elves wield charm and eloquence as deftly as any weapon. Their natural poise and sophistication grant them an edge in diplomacy, persuasion, and subtle manipulation. While sometimes seen as proud or aloof, they navigate social structures with unmatched finesse, often bending situations to their favor."
