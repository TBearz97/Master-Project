[sub_resource type="Resource" id="Resource_labk4"]
script = ExtResource("1_20kv3")
category = "Race"
_name = "Social Beings"
short_description = "Naturally persuasive, gaining a boost in conversations."
long_description = "With an innate charm and eloquence, High Elves effortlessly navigate social landscapes, bending conversations to their will with ease and finesse. High Elves have a knack for getting what they want in conversations, gain a +2 Social Modifier."

[resource]
script = ExtResource("2_s0pvo")
perk = SubResource("Resource_labk4")
_name = "High Elves"
short_description = "Charismatic masters of social influence."
long_description = "High Elves wield charm and eloquence as deftly as any weapon. Their natural poise and sophistication grant them an edge in diplomacy, persuasion, and subtle manipulation. While sometimes seen as proud or aloof, they navigate social structures with unmatched finesse, often bending situations to their favor."
