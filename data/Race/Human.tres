[sub_resource type="Resource" id="Resource_h7bi3"]
script = ExtResource("1_gs2jc")
category = "Race"
_name = "Good Natured"
short_description = "Share your full expertise when aiding allies, gaining the same rewards."
long_description = "Your kind-hearted and altruistic nature inspires and empowers your companions, allowing you to lend your full expertise to support them in their endeavors. When aiding another character you add your entire skill bonus rather than half. Any IP generated from that test you also gain."

[resource]
script = ExtResource("2_bp770")
perk = SubResource("Resource_h7bi3")
_name = "Human"
short_description = "Adaptable and altruistic, humans excel at lifting others up."
long_description = "Humans are known for their good-natured spirit and cooperative drive. Their generosity inspires trust and camaraderie, and their versatility allows them to thrive in nearly any role. While they may lack the extremes of other races, their strength lies in supporting allies and amplifying group success."
