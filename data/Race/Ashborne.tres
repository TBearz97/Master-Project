[sub_resource type="Resource" id="Resource_owwpf"]
script = ExtResource("1_ilfa0")
category = "Race"
_name = "Obsidian Patches"
short_description = "Living obsidian shields one patch of your body from harm."
long_description = "At the start of combat, one body location is chosen randomly. Attacks that hit that location deal no damage."

[resource]
script = ExtResource("2_tq1gu")
perk = SubResource("Resource_owwpf")
_name = "Ashborne"
short_description = "Volcanic-born beings clad in obsidian."
long_description = "Born of fire and forged in volcanic heartlands, Ashborne carry patches of living obsidian across their bodies. These hardened markings shield them from harm, embodying both their fiery origins and their resilience. Mysterious and formidable, they straddle the line between elemental power and mortal kin."
