[ext_resource type="Script" path="res://content/codex/character_options/race.gd" id="1_2kuo8"]

[resource]
script = ExtResource("1_2kuo8")
_name = "Goliath"
short_description = "Towering survivors shaped by harsh lands."
long_description = "Goliaths embody raw strength and endurance, honed by unforgiving environments that demand physical superiority. Their imposing presence and resilience make them formidable in battle, but this focus comes at a cost—their agility and social grace often lag behind. Survival defines their culture, and strength is their creed."
