[ext_resource type="Script" path="res://content/codex/character_options/race.gd" id="1_2d3yc"]

[resource]
script = ExtResource("1_2d3yc")
_name = "Halfling"
short_description = "Nimble and charming, but physically small."
long_description = "Halflings are quick-footed and warm-spirited, their small stature giving them an agility that belies their size. Loved for their charisma and adaptability, they thrive in both bustling towns and quiet villages. Yet their light build limits their strength and endurance, pushing them toward cleverness and community over brute force."
