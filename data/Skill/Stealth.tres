script = ExtResource("1_j2pch")
_name = "Stealth"
short_description = "The shadow’s embrace, unseen and unheard."
long_description = "Stealth is the skill of moving in silence, slipping past notice, and striking unseen. It is patience, precision, and the discipline to become part of the darkness itself."
