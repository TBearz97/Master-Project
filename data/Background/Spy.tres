[resource]
script = ExtResource("1_ld40t")
_name = "Spy"
short_description = "Skilled infiltrator trained in intrigue."
long_description = "Employed by the Nation or a business, you've led a life of infiltration and intrigue, learning how to sneak around, read people and fit in. Skills: Stealth, Speech, Insight, Investigation, Acrobatics or Society. Equipment: An Outfit of your choice."
