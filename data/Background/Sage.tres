script = ExtResource("1_1q4tc")
_name = "Sage"
short_description = "Scholar steeped in knowledge and study."
long_description = "You are a kith of books and study. You possess a vast amount of knowledge on several subjects or perhaps specialized in a few. Skills: Lore, Medicine, Arcana, Investigation or Navigation. Equipment: Scribe's Robe."
