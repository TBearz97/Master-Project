[ext_resource type="Script" path="res://content/codex/character_options/background.gd" id="1_aij4y"]

[resource]
script = ExtResource("1_aij4y")
_name = "Artisan"
short_description = "Craftsman devoted to honing a trade."
long_description = "You are an artisan spending most of your life honing your craft. You might spend life becoming the best in one field or you might want to learn the basics of several. Skills: Society, Discipline, Sleight of Hand, Melee Weapons or Ranged Weapons. Equipment: Outfit of your choice and Crafting Tools of your choice."
