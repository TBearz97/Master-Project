_name = "Wise Counsel"
short_description = "Your advice strengthens allies."
long_description = "Once per session, grant an ally advantage (roll 1d20 twice, take the better) on a Lore or Insight test."

[resource]
script = ExtResource("2_qo5da")
perk = SubResource("Resource_s6je5")
_name = "Elder"
short_description = "Wise figure recognized for knowledge and counsel."
long_description = "As an Elder of the tribe you possess more knowledge than most and can offer wisdom to those who need it. Elder is merely a title and does not reflect age, one is named Elder when one shows an aptitude for learning and is proven to be wise. Skills: Medicine, Lore, Survival, Animal Handling, Insight or Speech."
