[ext_resource type="Script" path="res://content/codex/character_options/background.gd" id="1_3x0to"]

[resource]
script = ExtResource("1_3x0to")
_name = "Dragon Knight"
short_description = "Elite warrior raised by the Dragon Knight Order."
long_description = "As a Dragon Knight you were brought up at one of the holds of the Dragon Knight Order. This could be because one or both your parents are a part of the order, because you lost your parents to a dragon attack at a young age or something else. Skills: Melee Weapons, Ranged Weapons, Lore, Acrobatics, Parry, Warfare or Medicine. Equipment: A set of Leather Armor or Scale Armor."
