[resource]
script = ExtResource("1_uwbbm")
_name = "Farmer"
short_description = "Humble worker living off the land."
long_description = "You are a simple farmer, such a life teaches one how to interact with animals, living off the land, crafting what you need and humble understanding of people. Skills: Animal Handling, Insight, Survival, Craft or Athletics. Equipment: A weapon of Rarity 0."
