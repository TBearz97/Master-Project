_name = "Home at Sea"
short_description = "At ease with ship life and navigation."
long_description = "You can re-roll 1d20 on Navigation tests while at sea. You also always gain Well-Rested when sleeping on a ship."

[resource]
script = ExtResource("2_rgu1d")
perk = SubResource("Resource_fal6a")
_name = "Pirate"
short_description = "Seafarer hardened by life on the waves."
long_description = "You have led a pirate's life learning to talk your way out of sticky situations, sailing on the open sea and living life among the less honored. Skills: Speech, Stealth, Sleight of Hand, Insight or Navigation. Equipment: Pirate's Attire."
