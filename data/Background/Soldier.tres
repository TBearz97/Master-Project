[ext_resource type="Script" path="res://content/codex/character_options/background.gd" id="1_nvayb"]

[resource]
script = ExtResource("1_nvayb")
_name = "Soldier"
short_description = "Disciplined fighter with military training."
long_description = "You have served with the Military and gained adequate military training as well as a proper education. After your service you get to keep your gear as reward for your service. However you are expected to report in at your nearest military post should get the call for duty. Skills: Discipline, Command, Melee Weapons, Ranged Weapons, Lore or Warfare. Equipment: Full set of Chain Mail or Leather Armor."
