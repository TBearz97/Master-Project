[ext_resource type="Script" path="res://content/codex/character_options/background.gd" id="1_ds3ic"]

[resource]
script = ExtResource("1_ds3ic")
_name = "Mercenary"
short_description = "Seasoned fighter accustomed to hard travel."
long_description = "As a Mercenary you are familiar with combat, traveling and taking care of yourself. Skills: Acrobatics, Melee Weapons, Ranged Weapons, Survival, Medicine, Parry or Resistance. Equipment: Wanderer's Leather Clothing and a Weapon of Rarity 2 or lower."
