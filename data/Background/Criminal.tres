[ext_resource type="Script" path="res://content/codex/character_options/background.gd" id="1_b5gv3"]

[resource]
script = ExtResource("1_b5gv3")
_name = "Criminal"
short_description = "Streetwise rogue from a life outside the law."
long_description = "You have led a criminal life learning to talk your way out of sticky situations, sneaking in the dark and living life among the less honored. Skills: Speech, Stealth, Investigation, Sleight of Hand or Insight. Equipment: Bandits Outfit and Lockpick Set. Language: Thieves' Cant."
