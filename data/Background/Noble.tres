[sub_resource type="Resource" id="Resource_rbhi6"]
script = ExtResource("1_35ma6")
category = "Background"
_name = "Courtly Privilege"
long_description = "You are accustomed to status, ceremony, and access. In appropriate civilized settings, you can secure basic hospitality or an audience that others might need to work harder to obtain."

[resource]
script = ExtResource("2_nkp7c")
perk = SubResource("Resource_rbhi6")
_name = "Noble"
short_description = "High-born individual with social standing."
long_description = "You are part of a Nobel family or have spent a significant portion of your life becoming one. A Nobel life comes with great social standing, understanding of money and perhaps even leadership skills. Skills: Discipline, Society, Command, Linguistics or Lore. Equipment: Nobels Attire and 100 Gold."
