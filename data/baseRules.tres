[sub_resource type="Resource" id="Resource_h87rk"]
script = ExtResource("1_u24hd")
_name = "Storm Volley"
long_description = "Fill an area with arrows and force everyone within it to react."

[sub_resource type="Resource" id="Resource_4ijcn"]
script = ExtResource("1_u24hd")
_name = "Street Sweeper"
long_description = "The full brutal expression of a scatter gun in cramped fighting."

[sub_resource type="Resource" id="Resource_w8iyr"]
script = ExtResource("1_u24hd")
_name = "Strike"
short_description = "A basic attack."
long_description = "A direct, unadorned blow."

[sub_resource type="Resource" id="Resource_bj2lw"]
script = ExtResource("1_u24hd")
_name = "Suppressing Shot"
long_description = "Force the enemy to keep their head down and give up space."

[sub_resource type="Resource" id="Resource_0243t"]
script = ExtResource("1_u24hd")
_name = "Sweep"
short_description = "A wide sweeping attack."
long_description = "A broad arc that can catch multiple foes."

[sub_resource type="Resource" id="Resource_7losg"]
script = ExtResource("1_u24hd")
_name = "Swing"
long_description = "A straightforward hammering attack with solid momentum."

[sub_resource type="Resource" id="Resource_yoeu8"]
script = ExtResource("1_u24hd")
_name = "Thousand Cuts"
long_description = "A relentless series of shallow strikes that build pressure quickly."

[sub_resource type="Resource" id="Resource_rvoxu"]
script = ExtResource("1_u24hd")
_name = "Thrust"
short_description = "A precise piercing attack."
long_description = "A focused lunge driving the point into the target."

[sub_resource type="Resource" id="Resource_7eklp"]
script = ExtResource("1_u24hd")
_name = "Thunder Mouth"
long_description = "A concussive close-range discharge that leaves survivors reeling."

[sub_resource type="Resource" id="Resource_wbwhm"]
script = ExtResource("1_u24hd")
_name = "Tomb Hammer"
long_description = "A full-bodied maul swing meant to end resistance outright."

[sub_resource type="Resource" id="Resource_ubpam"]
script = ExtResource("1_u24hd")
_name = "Twin Moon Cut"
long_description = "A flowing finishing pattern that strikes in a seamless pair."

[sub_resource type="Resource" id="Resource_022mg"]
script = ExtResource("1_u24hd")
_name = "Twist"
long_description = "A precise turn of the weapon after contact to deepen the harm."

[sub_resource type="Resource" id="Resource_6to4o"]
script = ExtResource("1_u24hd")
_name = "Vaulting Blow"
long_description = "A mobile staff strike that turns movement into impact."

[sub_resource type="Resource" id="Resource_u7i8t"]
script = ExtResource("1_u24hd")
_name = "Vein Hunter"
long_description = "A wickedly placed crossbow shot aimed at the most vulnerable point available."

[sub_resource type="Resource" id="Resource_nl0j0"]
script = ExtResource("1_u24hd")
_name = "Wall Nailer"
long_description = "A heavy bolt that hammers the target into place with terrifying force."

[sub_resource type="Resource" id="Resource_qqjmb"]
script = ExtResource("1_u24hd")
_name = "Whirling Step"
long_description = "A curving moving attack that changes angle mid-assault."

[sub_resource type="Resource" id="Resource_1k2sg"]
script = ExtResource("1_u24hd")
_name = "Wing Clip"
long_description = "A strike meant to ruin footing and cut off clean movement."

[sub_resource type="Resource" id="Resource_maqnd"]
script = ExtResource("1_u24hd")
_name = "World Splitter"
long_description = "A great axe blow delivered with maximum force and commitment."

[sub_resource type="Resource" id="Resource_byipy"]
script = ExtResource("1_u24hd")
_name = "Wrap"
long_description = "You curl the attack around the target to interfere with their position."

[sub_resource type="Resource" id="Resource_lh87t"]
script = ExtResource("2_sd042")
modifier_1_name = "Damage & Healing"
modifier_1_expression = "(x - 5) * 7"
modifier_1_suffix = "%"
modifier_2_name = "Max Carry Weight"
modifier_2_expression = "(x * 10) + 45"
modifier_2_suffix = "kg"
_name = "Might"
short_description = "Represents physical and spiritual strength."
long_description = "Might measures the character’s raw physical and inner power. It influences both physical and magical damage as well as the effectiveness of healing abilities. Characters with higher Might deal and heal more damage and can carry heavier loads."

[sub_resource type="Resource" id="Resource_75pra"]
script = ExtResource("2_sd042")
modifier_1_name = "Action Points"
modifier_1_expression = "x + 6 - floor(x / 4)"
modifier_2_name = "Deflection"
modifier_2_expression = "x"
_name = "Dexterity"
short_description = "Represents speed, coordination, and reflexes."
long_description = "Dexterity reflects a character’s agility and precision in both physical and mental actions. It governs how quickly and efficiently a character can move, attack, and react. High Dexterity grants additional action points, allowing more actions per turn, and improves deflection, helping to avoid incoming attacks."

[sub_resource type="Resource" id="Resource_gc8h4"]
script = ExtResource("2_sd042")
modifier_1_name = "Health"
modifier_1_expression = "x + 5"
modifier_1_suffix = "x Level"
modifier_2_name = "Vitality"
modifier_2_expression = "3 + floor(x / 3)"
modifier_2_suffix = "x Health"
_name = "Constitution"
short_description = "Represents endurance and overall toughness."
long_description = "Constitution determines a character’s physical resilience and ability to withstand harm, fatigue, and disease. It directly affects maximum health and long-term vitality, influencing how long a character can endure in battle or harsh environments. Those with higher Constitution can take more punishment and recover faster from strain."

[sub_resource type="Resource" id="Resource_rdm6v"]
script = ExtResource("2_sd042")
modifier_1_name = "Accuracy"
modifier_1_expression = "x + 2"
modifier_2_name = "Crit Dice"
modifier_2_expression = "2 * ceil(x / 2.0) + 2"
_name = "Perception"
short_description = "Represents awareness and precision."
long_description = "Perception measures a character’s ability to notice details, aim accurately, and react swiftly to subtle changes in their surroundings. High Perception increases accuracy with all attacks and improves the likelihood of striking vital points, resulting in more devastating critical hits."

[sub_resource type="Resource" id="Resource_qliu3"]
script = ExtResource("2_sd042")
modifier_1_name = "Potency"
modifier_1_expression = "x + 2"
modifier_2_name = "Bestiary Progression"
modifier_2_expression = "x * 3"
modifier_2_suffix = "%"
_name = "Intelligence"
short_description = "Represents reasoning and analytical ability."
long_description = "Intelligence governs a character’s capacity for logic, learning, and understanding complex systems. It enhances awareness of enemies and the environment, improving bestiary knowledge and analysis. High Intelligence also refines control over magical and tactical effects, increasing the duration of buffs and debuffs applied in combat."

[sub_resource type="Resource" id="Resource_hcsc2"]
script = ExtResource("2_sd042")
modifier_1_name = "Mana Generation"
modifier_1_expression = "floor(x / 2)"
modifier_2_name = "Concentration"
modifier_2_expression = "ceil(x / 2.0)"
_name = "Resolve"
short_description = "Represents mental fortitude and determination."
long_description = "Resolve reflects a character’s strength of will, focus, and emotional stability under pressure. It determines how well a character maintains concentration during combat and how resistant they are to negative mental or magical effects. Characters with high Resolve can shrug off debilitating conditions and remain steadfast in challenging situations."

[sub_resource type="Resource" id="Resource_ociry"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Military Training"
long_description = "During combat, you gain 1 additional AP each turn that can only be spent on movement."

[sub_resource type="Resource" id="Resource_ykhem"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_ociry")
_name = "Soldier"
short_description = "Disciplined fighter with military training."
long_description = "You have served with the Military and gained adequate military training as well as a proper education. After your service you get to keep your gear as reward for your service. However you are expected to report in at your nearest military post should get the call for duty. Skills: Discipline, Command, Melee Weapons, Ranged Weapons, Lore or Warfare. Equipment: Full set of Chain Mail or Leather Armor."

[sub_resource type="Resource" id="Resource_57ogm"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Underhanded"
long_description = "You do not need lockpicks in order to pick a lock."

[sub_resource type="Resource" id="Resource_0ou3h"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_57ogm")
_name = "Criminal"
short_description = "Streetwise rogue from a life outside the law."
long_description = "You have led a criminal life learning to talk your way out of sticky situations, sneaking in the dark and living life among the less honored. Skills: Speech, Stealth, Investigation, Sleight of Hand or Insight. Equipment: Bandits Outfit and Lockpick Set. Language: Thieves' Cant."

[sub_resource type="Resource" id="Resource_b7hbs"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Deep Cover"
long_description = "Your Renown is increased while you are undercover or disguised."

[sub_resource type="Resource" id="Resource_m8osy"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_b7hbs")
_name = "Spy"
short_description = "Skilled infiltrator trained in intrigue."
long_description = "Employed by the Nation or a business, you've led a life of infiltration and intrigue, learning how to sneak around, read people and fit in. Skills: Stealth, Speech, Insight, Investigation, Acrobatics or Society. Equipment: An Outfit of your choice."

[sub_resource type="Resource" id="Resource_rbhi6"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Courtly Privilege"
long_description = "You are accustomed to status, ceremony, and access. In appropriate civilized settings, you can secure basic hospitality or an audience that others might need to work harder to obtain."

[sub_resource type="Resource" id="Resource_e0l83"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_rbhi6")
_name = "Noble"
short_description = "High-born individual with social standing."
long_description = "You are part of a Nobel family or have spent a significant portion of your life becoming one. A Nobel life comes with great social standing, understanding of money and perhaps even leadership skills. Skills: Discipline, Society, Command, Linguistics or Lore. Equipment: Nobels Attire and 100 Gold."

[sub_resource type="Resource" id="Resource_jbm2q"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Simple Living"
long_description = "Food and shelter you provide can support one additional person."

[sub_resource type="Resource" id="Resource_emj35"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_jbm2q")
_name = "Farmer"
short_description = "Humble worker living off the land."
long_description = "You are a simple farmer, such a life teaches one how to interact with animals, living off the land, crafting what you need and humble understanding of people. Skills: Animal Handling, Insight, Survival, Craft or Athletics. Equipment: A weapon of Rarity 0."

[sub_resource type="Resource" id="Resource_tmls4"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Educated"
short_description = "Advanced scholarly training."
long_description = "Tag Skills increases a Skill by 3 rather than 2."

[sub_resource type="Resource" id="Resource_mlb52"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_tmls4")
_name = "Sage"
short_description = "Scholar steeped in knowledge and study."
long_description = "You are a kith of books and study. You possess a vast amount of knowledge on several subjects or perhaps specialized in a few. Skills: Lore, Medicine, Arcana, Investigation or Navigation. Equipment: Scribe's Robe."

[sub_resource type="Resource" id="Resource_nt1kf"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Sanctified Presence"
long_description = "Followers of your faith tend to treat you as one of their own unless given reason not to."

[sub_resource type="Resource" id="Resource_vkqus"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_nt1kf")
_name = "Acolyte"
short_description = "Devout follower with religious training."
long_description = "You are a kith of faith. An acolyte's life is spent learning about modesty and a deeper understanding of your religion. Skills: Discipline, Arcana, Lore, Speech or Medicine. Equipment: Priest's Garments."

[sub_resource type="Resource" id="Resource_wya6k"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Crowd Favorite"
long_description = "People are more willing to feed, host, or hear you out after a performance."

[sub_resource type="Resource" id="Resource_dawyx"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_wya6k")
_name = "Entertainer"
short_description = "Performer who thrives in social settings."
long_description = "You are an entertainer traveling around, meeting people and enjoying the social aspects of life. Skills: Speech, Society, Insight, Acrobatics, Parry or Linguistics. Equipment: Performer's Outfit and an Instrument of Choice."

[sub_resource type="Resource" id="Resource_i1k48"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Efficient Worker"
long_description = "Crafting uses fewer resources."

[sub_resource type="Resource" id="Resource_r0kmt"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_i1k48")
_name = "Artisan"
short_description = "Craftsman devoted to honing a trade."
long_description = "You are an artisan spending most of your life honing your craft. You might spend life becoming the best in one field or you might want to learn the basics of several. Skills: Society, Discipline, Sleight of Hand, Melee Weapons or Ranged Weapons. Equipment: Outfit of your choice and Crafting Tools of your choice."

[sub_resource type="Resource" id="Resource_04uxq"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Hardened Routine"
long_description = "During each full rest, you may also remove 1 Fatigue if you have no remaining source causing it."

[sub_resource type="Resource" id="Resource_y7yfb"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_04uxq")
_name = "Mercenary"
short_description = "Seasoned fighter accustomed to hard travel."
long_description = "As a Mercenary you are familiar with combat, traveling and taking care of yourself. Skills: Acrobatics, Melee Weapons, Ranged Weapons, Survival, Medicine, Parry or Resistance. Equipment: Wanderer's Leather Clothing and a Weapon of Rarity 2 or lower."

[sub_resource type="Resource" id="Resource_32jlc"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Trailblazer"
short_description = "Guide others safely through the wild."
long_description = "Your party ignores the first hour of travel penalties (fatigue, hunger, or navigation difficulty) each day."

[sub_resource type="Resource" id="Resource_s4q2c"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_32jlc")
_name = "Pathfinder"
short_description = "Guide skilled at navigating the wilds."
long_description = "As a Pathfinder you have spent your life helping others navigate through landscapes without roads. Skills: Survival, Resistance, Athletics, Investigation or Stealth. Equipment: Ranger's Outfit and a Map of your Homeland."

[sub_resource type="Resource" id="Resource_ym2ql"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Haggle for a Living"
short_description = "A lifetime of trading hones your bargaining."
long_description = "You can re-roll 1d20 when browsing, and always gain a 10% discount."

[sub_resource type="Resource" id="Resource_mmdr2"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_ym2ql")
_name = "Trader"
short_description = "Wanderer of roads and markets, skilled at bargaining."
long_description = "As a Trader you are familiar with the life on the road or sea as well as you are socially adept. You might have traveled across the border into neighboring nations. Skills: Speech, Survival, Navigation or Insight."

[sub_resource type="Resource" id="Resource_fal6a"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Home at Sea"
short_description = "At ease with ship life and navigation."
long_description = "You can re-roll 1d20 on Navigation tests while at sea. You also always gain Well-Rested when sleeping on a ship."

[sub_resource type="Resource" id="Resource_hjjn8"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_fal6a")
_name = "Pirate"
short_description = "Seafarer hardened by life on the waves."
long_description = "You have led a pirate's life learning to talk your way out of sticky situations, sailing on the open sea and living life among the less honored. Skills: Speech, Stealth, Sleight of Hand, Insight or Navigation. Equipment: Pirate's Attire."

[sub_resource type="Resource" id="Resource_iefut"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Arena Instinct"
long_description = "The first time each combat you would become Prone, you may ignore it."

[sub_resource type="Resource" id="Resource_7n254"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_iefut")
_name = "Gladiator"
short_description = "Arena warrior trained for brutal combat."
long_description = "As a Gladiator you are familiar with combat and taking care of yourself. Skills: Warfare, Parry, Resistance or Athletics. Equipment: Tribal Outfit and a Weapon of Rarity 2 or lower."

[sub_resource type="Resource" id="Resource_81d5q"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Forager"
short_description = "Gather more resources."
long_description = "Find additional herbs, food, and crafting materials."

[sub_resource type="Resource" id="Resource_ubo2m"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_81d5q")
_name = "Hunter"
short_description = "Tracker and forager skilled in the wild."
long_description = "As a Hunter you are adept at tracking animals or gathering fruits and berries. Skills: Animal Handling, Discipline, Ranged Weapons or Melee Weapons. Equipment: Ranger's Outfit."

[sub_resource type="Resource" id="Resource_s6je5"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Wise Counsel"
short_description = "Your advice strengthens allies."
long_description = "Once per session, grant an ally advantage (roll 1d20 twice, take the better) on a Lore or Insight test."

[sub_resource type="Resource" id="Resource_xj6mq"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_s6je5")
_name = "Elder"
short_description = "Wise figure recognized for knowledge and counsel."
long_description = "As an Elder of the tribe you possess more knowledge than most and can offer wisdom to those who need it. Elder is merely a title and does not reflect age, one is named Elder when one shows an aptitude for learning and is proven to be wise. Skills: Medicine, Lore, Survival, Animal Handling, Insight or Speech."

[sub_resource type="Resource" id="Resource_tcolt"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Beast Handler"
long_description = "You gain an Animal Handling perk."

[sub_resource type="Resource" id="Resource_oneye"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_tcolt")
_name = "Beast Tamer"
short_description = "Handler skilled at taming and caring for animals."
long_description = "As a Beast Tamer you have had the responsibility of taming and keeping the animals of the tribe. Skills: Survival, Athletics, Acrobatics, Medicine or Insight."

[sub_resource type="Resource" id="Resource_4iukm"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Trained to Kill"
short_description = "Dragons are your sworn enemy."
long_description = "Reduce the Difficulty of Survival tests when tracking Dragons by 1. Re-roll 1d20 on every damaging attack against a Dragon. After killing a Dragon local villages will celebrate you as a hero, this means you sleep, drink and eat for free for the next 3 days."

[sub_resource type="Resource" id="Resource_7lif3"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_4iukm")
_name = "Dragon Knight"
short_description = "Elite warrior raised by the Dragon Knight Order."
long_description = "As a Dragon Knight you were brought up at one of the holds of the Dragon Knight Order. This could be because one or both your parents are a part of the order, because you lost your parents to a dragon attack at a young age or something else. Skills: Melee Weapons, Ranged Weapons, Lore, Acrobatics, Parry, Warfare or Medicine. Equipment: A set of Leather Armor or Scale Armor."

[sub_resource type="Resource" id="Resource_1lxa4"]
script = ExtResource("4_wtekf")
category = "Background"
_name = "Secluded"
short_description = "Withdrawn life grants quiet insight."
long_description = "After character creation, gain a Perk in each of your Tag skills, but CHA tests suffer a permanent increase in difficulty by 2."

[sub_resource type="Resource" id="Resource_p5lby"]
script = ExtResource("3_fgwrd")
perk = SubResource("Resource_1lxa4")
_name = "Hermit"
short_description = "Solitary wanderer who chose a life apart."
long_description = "As a Hermit you have cast aside the stressful life among society for the preferable life of solitude. Skills: Survival, Lore, Arcana, Medicine or Discipline."

[sub_resource type="Resource" id="Resource_ygaow"]
script = ExtResource("5_g4iik")
_name = "Burning"
short_description = "On fire."
long_description = "The creature is engulfed in flames and may take ongoing fire damage until the effect ends."

[sub_resource type="Resource" id="Resource_2c8w3"]
script = ExtResource("5_g4iik")
_name = "Poisoned"
short_description = "Suffering from a toxic effect."
long_description = "The creature is weakened by poison and may take ongoing harm or penalties."

[sub_resource type="Resource" id="Resource_dajwb"]
script = ExtResource("5_g4iik")
_name = "Prone"
short_description = "Knocked to the ground."
long_description = "Movement is hindered and melee and ranged attackers interact differently with the target."

[sub_resource type="Resource" id="Resource_4c1ps"]
script = ExtResource("2_sd042")

[sub_resource type="Resource" id="Resource_4wrh6"]
script = ExtResource("6_s7vjf")
attribute1 = SubResource("Resource_75pra")
attribute2 = SubResource("Resource_4c1ps")
_name = "Deflection"
short_description = "Determines whether weapon attacks hit."
long_description = "Deflection protects against melee and ranged weapon attacks."

[sub_resource type="Resource" id="Resource_duml7"]
script = ExtResource("6_s7vjf")
attribute1 = SubResource("Resource_75pra")
attribute2 = SubResource("Resource_rdm6v")
_name = "Reflex"
short_description = "Avoids area-of-effect dangers."
long_description = "Reflex helps avoid area-of-effect attacks such as explosions and traps."

[sub_resource type="Resource" id="Resource_t54am"]
script = ExtResource("6_s7vjf")
attribute1 = SubResource("Resource_lh87t")
attribute2 = SubResource("Resource_gc8h4")
_name = "Endurance"
short_description = "Resists physical effects."
long_description = "Endurance resists physical effects such as poison, disease, and knockdowns."

[sub_resource type="Resource" id="Resource_8mic7"]
script = ExtResource("6_s7vjf")
attribute1 = SubResource("Resource_qliu3")
attribute2 = SubResource("Resource_hcsc2")
_name = "Mind"
short_description = "Defends against mental effects."
long_description = "Mind resists mental effects such as charm, fear, and confusion."

[sub_resource type="Resource" id="Resource_6a210"]
script = ExtResource("4_wtekf")
category = "Homeland"
_name = "Circle of Life"
long_description = "Nothing Wasted. You know how to make use of what nature gives and what it takes."

[sub_resource type="Resource" id="Resource_jm6yd"]
script = ExtResource("7_q5p5o")
perk = SubResource("Resource_6a210")
_name = "The Ur'Holdum Jungle"
short_description = "Dense, perilous jungle where survival skills are second nature."
long_description = "You can choose one additional Tag skill among the following: Animal Handling, Survival or Medicine."

[sub_resource type="Resource" id="Resource_y3rwi"]
script = ExtResource("4_wtekf")
category = "Homeland"
_name = "Proper Bearing"
long_description = "Your upbringing in a refined kingdom grants you the manners and expectations of civilized life. In formal settings, you are treated with the respect due to proper station unless you give others reason not to."

[sub_resource type="Resource" id="Resource_iv5ld"]
script = ExtResource("7_q5p5o")
perk = SubResource("Resource_y3rwi")
_name = "The Orotari Kingdom"
short_description = "A refined kingdom where education and knowledge flourish."
long_description = "You can choose one additional Tag skill among the following: Society, Warfare or Discipline. Also gain a language of your choice."

[sub_resource type="Resource" id="Resource_vfnxm"]
script = ExtResource("4_wtekf")
category = "Homeland"
_name = "Frostborn"
short_description = "Adapted to endure freezing climates."
long_description = "You can increase your survival rating by 1.5 when it comes to exposure to cold weather. Also, you can reduce Freeze Effects on you by 1."

[sub_resource type="Resource" id="Resource_287v2"]
script = ExtResource("7_q5p5o")
perk = SubResource("Resource_vfnxm")
_name = "The Frostheim Kingdom"
short_description = "Frozen lands where endurance against the cold is a way of life."
long_description = "You can increase your survival rating by 1.5 when it comes to exposure to cold weather. Also, you can reduce Freeze Effects on you by 1."

[sub_resource type="Resource" id="Resource_o7737"]
script = ExtResource("4_wtekf")
category = "Homeland"
_name = "Desert Adventurer"
short_description = "Adapted to endure scorching desert climates."
long_description = "You can increase your survival rating by 1.5 when it comes to exposure to hot weather. You can go an hour longer for every stage of Thirst and hot weather does not halve it."

[sub_resource type="Resource" id="Resource_p3tqy"]
script = ExtResource("7_q5p5o")
perk = SubResource("Resource_o7737")
_name = "The Quasarian Empire"
short_description = "Harsh desert empire where heat and thirst shape daily survival."
long_description = "You can increase your survival rating by 1.5 when it comes to exposure to hot weather. You can go an hour longer for every stage of Thirst and hot weather does not halve it."

[sub_resource type="Resource" id="Resource_he835"]
script = ExtResource("4_wtekf")
category = "Homeland"
_name = "No Safe Roads"
long_description = "Travel-related rules will favor your experience once those systems are in place."

[sub_resource type="Resource" id="Resource_xpe3f"]
script = ExtResource("7_q5p5o")
perk = SubResource("Resource_he835")
_name = "The Untamed Highlands"
short_description = "A patchwork of wild cities where adaptability is essential."
long_description = "Due to the many different cities in the Untamed Highlands, you've learned to adapt to different societies. During carousing you can re-roll 1d20 on your Society test."

[sub_resource type="Resource" id="Resource_5pv4y"]
script = ExtResource("4_wtekf")
category = "Homeland"
_name = "Born to Fight"
short_description = "Innate battle instinct, able to shrug off danger."
long_description = "Once per scene, you can completely ignore one attack that targets you."

[sub_resource type="Resource" id="Resource_kxp8i"]
script = ExtResource("7_q5p5o")
perk = SubResource("Resource_5pv4y")
_name = "Torgana Canyons"
short_description = "Harsh canyon homeland where only the strongest prevail."
long_description = "Once per scene, you can completely ignore one attack that targets you."

[sub_resource type="Resource" id="Resource_hfu8n"]
script = ExtResource("4_wtekf")
category = "Homeland"
_name = "Looter"
short_description = "Skilled at finding extra valuables."
long_description = "Whenever you successfully salvage an area, you also gain a free roll on the Oddities and Valuables table."

[sub_resource type="Resource" id="Resource_upq2y"]
script = ExtResource("7_q5p5o")
perk = SubResource("Resource_hfu8n")
_name = "Calatherian Principality"
short_description = "Seafaring principality where piracy and trade intermingle."
long_description = "Whenever you successfully salvage an area, you also gain a free roll on the Oddities and Valuables table."

[sub_resource type="Resource" id="Resource_44npp"]
script = ExtResource("4_wtekf")
category = "Homeland"
_name = "Animal Friend"
short_description = "Peaceful bond with beasts."
long_description = "When you encounter a creature with the Beast Keyword, it will never attack you on sight. Also gain 1 re-roll on all Animal Handling tests."

[sub_resource type="Resource" id="Resource_cjwpc"]
script = ExtResource("7_q5p5o")
perk = SubResource("Resource_44npp")
_name = "Asharati Forest"
short_description = "Deep, mystical woods where harmony with beasts is sacred."
long_description = "When you encounter a creature with the Beast Keyword, it will never attack you on sight. Also gain 1 re-roll on all Animal Handling tests."

[sub_resource type="Resource" id="Resource_yj421"]
script = ExtResource("4_wtekf")
category = "Homeland"
_name = "Wanderer"
long_description = "You can become Well-Rested even when sleeping in rough conditions that would normally prevent it."

[sub_resource type="Resource" id="Resource_yvjct"]
script = ExtResource("7_q5p5o")
perk = SubResource("Resource_yj421")
_name = "No Homeland"
short_description = "Rootless wanderers who belong to no land or kingdom."
long_description = "When you choose to not have a homeland, you choose to belong to a different entity. Thus you will instead gain a Perk from Background."

[sub_resource type="Resource" id="Resource_smyrt"]
script = ExtResource("4_wtekf")
category = "Homeland"
_name = "Survivor"
short_description = "Hardened against toxins and hazards."
long_description = "Due to your upbringing in a hazardous land, you have learned to survive toxic and dangerous areas. When taking Hazard damage, you only take half."

[sub_resource type="Resource" id="Resource_t0fv2"]
script = ExtResource("7_q5p5o")
perk = SubResource("Resource_smyrt")
_name = "Aratori Dominion"
short_description = "Toxic, hazardous land where only hardened survivors thrive."
long_description = "Due to your upbringing in a hazardous land, you have learned to survive toxic and dangerous areas. When taking Hazard damage, you only take half."

[sub_resource type="Resource" id="Resource_hvctk"]
script = ExtResource("4_wtekf")
category = "Homeland"
_name = "Scorched Resourcefulness"
long_description = "Foraging becomes easier anywhere."

[sub_resource type="Resource" id="Resource_d8kd5"]
script = ExtResource("7_q5p5o")
perk = SubResource("Resource_hvctk")
_name = "The Obsidian Desert"
short_description = "Scorching desert where resilience to heat is vital."
long_description = "You can survive in hot weather without any penalty, and extreme hot weather is treated as hot weather."

