id = 21
_name = "Military Training"
short_description = "Gain 1 additional movement-only AP each turn in combat."
long_description = "During combat, you gain 1 additional AP each turn that can only be spent on movement."

[sub_resource type="Resource" id="Resource_nw44m"]
script = ExtResource("8_dcwdo")
max_rank = 10
id = 2
_name = "Athletics"
short_description = "The measure of strength, speed, and stamina in motion."
long_description = "Athletics is the discipline of the body pushed to its limits — running, climbing, leaping, and enduring trials that test both muscle and breath. It is the difference between faltering on the field and pressing forward with unyielding vigor."

[sub_resource type="Resource" id="Resource_qh5pf"]
script = ExtResource("8_dcwdo")
max_rank = 10
id = 14
_name = "Survival"
short_description = "The knowledge to endure the wilds."
long_description = "Survival is the understanding of nature’s dangers and gifts — how to find water, build shelter, track game, and weather storm or famine. It is the art of living where the land itself may seek to claim you."

[sub_resource type="Resource" id="Resource_8o7yg"]
script = ExtResource("6_53hui")
perk = SubResource("Resource_p45st")
skill_1 = SubResource("Resource_nw44m")
skill_2 = SubResource("Resource_qh5pf")
id = 1
_name = "Soldier"
short_description = "Disciplined fighter shaped by military service."
long_description = "You served in a structured military force where discipline, hierarchy, and training defined your life. You learned to operate under pressure, follow orders, and lead when required. Even after leaving service, that conditioning remains, and you may still feel the pull of duty when called upon."

[sub_resource type="Resource" id="Resource_04t46"]
script = ExtResource("7_5pqe7")
category = "Background"
requirement_text = "Criminal only"
id = 22
_name = "Underhanded"
short_description = "Pick locks without needing lockpicks."
long_description = "You do not need lockpicks in order to pick a lock."

[sub_resource type="Resource" id="Resource_uo72s"]
script = ExtResource("8_dcwdo")
max_rank = 10
id = 13
_name = "Stealth"
short_description = "The shadow’s embrace, unseen and unheard."
long_description = "Stealth is the skill of moving in silence, slipping past notice, and striking unseen. It is patience, precision, and the discipline to become part of the darkness itself."

[sub_resource type="Resource" id="Resource_4nqnc"]
script = ExtResource("8_dcwdo")
max_rank = 10
id = 10
_name = "Sleight of Hand"
short_description = "The art of swift, subtle fingers."
long_description = "Sleight of hand is dexterity made invisible — a coin vanished, a purse lifted, a dagger drawn before the eye can follow. It is trickery and finesse, both performance and deception."

[sub_resource type="Resource" id="Resource_xvgww"]
script = ExtResource("6_53hui")
perk = SubResource("Resource_04t46")
skill_1 = SubResource("Resource_uo72s")
skill_2 = SubResource("Resource_4nqnc")
id = 2
_name = "Criminal"
short_description = "Streetwise survivor shaped by a life outside the law."
long_description = "You lived beyond the bounds of legality, relying on cunning, adaptability, and instinct. Navigating dangerous situations, reading people, and surviving among society’s shadows became second nature to you."

[sub_resource type="Resource" id="Resource_p2w34"]
script = ExtResource("7_5pqe7")
category = "Background"
requirement_text = "Spy only"
id = 23
_name = "Deep Cover"
short_description = "Your Renown is increased while undercover or disguised."
long_description = "Your Renown is increased while you are undercover or disguised."

[sub_resource type="Resource" id="Resource_npp36"]
script = ExtResource("8_dcwdo")
max_rank = 10
id = 5
_name = "Insight"
short_description = "The ability to read truth in others."
long_description = "Insight is the quiet observation of subtle gestures, unspoken words, and hidden motives. It is the wisdom to look beyond appearances, discerning intent from shadow and sincerity from deceit."

[sub_resource type="Resource" id="Resource_tayhs"]
script = ExtResource("8_dcwdo")
max_rank = 10
id = 11
_name = "Society"
short_description = "The understanding of order, law, and custom."
long_description = "Society is the study of how people live together: their structures of power, their traditions, their spoken and unspoken rules. One skilled in society can navigate courts and markets alike, finding their place among folk of every station."

[sub_resource type="Resource" id="Resource_qyjiv"]
script = ExtResource("6_53hui")
