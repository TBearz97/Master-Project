_name = "Sage"
short_description = "Scholar devoted to learning and intellectual pursuits."
long_description = "Your life has been dedicated to study, research, and the pursuit of knowledge. Whether broadly educated or deeply specialized, you rely on reason, memory, and insight to understand the world."

[sub_resource type="Resource" id="Resource_32s0h"]
