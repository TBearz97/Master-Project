skill_1 = SubResource("Resource_tayhs")
skill_2 = SubResource("Resource_edehd")
id = 4
_name = "Noble"
short_description = "Individual of high birth or elevated social standing."
long_description = "You were raised among wealth, influence, and expectation, or rose into such a position through effort or circumstance. You understand power structures, social etiquette, and the responsibilities—and privileges—that come with status."

[sub_resource type="Resource" id="Resource_iut7d"]
