id = 1
_name = "Might"
short_description = "Represents physical and spiritual strength."
long_description = "Might measures the character’s raw physical and inner power. It influences both physical and magical damage as well as the effectiveness of healing abilities. Characters with higher Might deal and heal more damage and can carry heavier loads."

[sub_resource type="Resource" id="Resource_c1bn1"]
script = ExtResource("5_5qo2o")
id = 3
_name = "Action Points"
short_description = "Determines available actions per turn."
long_description = "Action Points represent how many actions a character can take during their turn. Increasing this value allows for more actions each round."

[sub_resource type="Resource" id="Resource_me7p3"]
script = ExtResource("5_5qo2o")
id = 4
_name = "Deflection"
short_description = "Improves chance to avoid attacks."
long_description = "Deflection determines how difficult it is for enemies to land weapon attacks against you. Higher Deflection increases your chance to avoid incoming attacks."

[sub_resource type="Resource" id="Resource_1wl2v"]
