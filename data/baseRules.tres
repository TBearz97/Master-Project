[sub_resource type="Resource" id="Resource_lh87t"]
script = ExtResource("3_n05yy")
bonus_1_prefix = "Damage & Healing:"
bonus_2_prefix = "Carry Weight:"
bonus_1_expression = "(x -  5) * 7"
bonus_2_expression = "(x * 10) + 45"
bonus_1_suffix = "%"
bonus_2_suffix = "kg"
_name = "Might"
short_description = "Represents physical and spiritual strength."
long_description = "Might measures the character’s raw physical and inner power. It influences both physical and magical damage as well as the effectiveness of healing abilities. Characters with higher Might deal and heal more damage and can carry heavier loads."

[sub_resource type="Resource" id="Resource_75pra"]
script = ExtResource("3_n05yy")
bonus_1_prefix = "Action Points:"
bonus_2_prefix = "Deflection:"
bonus_1_expression = "x + 6 - floor(x / 4)"
bonus_2_expression = "x"
_name = "Dexterity"
short_description = "Represents speed, coordination, and reflexes."
long_description = "Dexterity reflects a character’s agility and precision in both physical and mental actions. It governs how quickly and efficiently a character can move, attack, and react. High Dexterity grants additional action points, allowing more actions per turn, and improves deflection, helping to avoid incoming attacks."

[sub_resource type="Resource" id="Resource_gc8h4"]
script = ExtResource("3_n05yy")
bonus_1_prefix = "Health:"
bonus_2_prefix = "Vitality:"
bonus_1_expression = "x + 5"
bonus_2_expression = "(3 + floor((x - 1) / 3))"
bonus_1_suffix = "x Level"
bonus_2_suffix = "x Health"
_name = "Constitution"
short_description = "Represents endurance and overall toughness."
long_description = "Constitution determines a character’s physical resilience and ability to withstand harm, fatigue, and disease. It directly affects maximum health and long-term vitality, influencing how long a character can endure in battle or harsh environments. Those with higher Constitution can take more punishment and recover faster from strain."

[sub_resource type="Resource" id="Resource_rdm6v"]
script = ExtResource("3_n05yy")
bonus_1_prefix = "Accuracy:"
bonus_2_prefix = "Crit Dice : d"
bonus_1_expression = "x + 2"
bonus_2_expression = "2 * ceil(x / 2.0) + 2"
_name = "Perception"
short_description = "Represents awareness and precision."
long_description = "Perception measures a character’s ability to notice details, aim accurately, and react swiftly to subtle changes in their surroundings. High Perception increases accuracy with all attacks and improves the likelihood of striking vital points, resulting in more devastating critical hits."

[sub_resource type="Resource" id="Resource_qliu3"]
script = ExtResource("3_n05yy")
bonus_1_prefix = "Potency"
bonus_2_prefix = "Bestiary Progress:"
bonus_1_expression = "x + 2"
bonus_2_expression = "x *  3"
bonus_2_suffix = "%"
_name = "Intelligence"
short_description = "Represents reasoning and analytical ability."
long_description = "Intelligence governs a character’s capacity for logic, learning, and understanding complex systems. It enhances awareness of enemies and the environment, improving bestiary knowledge and analysis. High Intelligence also refines control over magical and tactical effects, increasing the duration of buffs and debuffs applied in combat."

[sub_resource type="Resource" id="Resource_hcsc2"]
script = ExtResource("3_n05yy")
bonus_1_prefix = "Mana Generation:"
bonus_2_prefix = "Concentration:"
bonus_1_expression = "floor(x / 2)"
bonus_2_expression = "ceil(x / 2.0)"
_name = "Resolve"
short_description = "Represents mental fortitude and determination."
long_description = "Resolve reflects a character’s strength of will, focus, and emotional stability under pressure. It determines how well a character maintains concentration during combat and how resistant they are to negative mental or magical effects. Characters with high Resolve can shrug off debilitating conditions and remain steadfast in challenging situations."

[sub_resource type="Resource" id="Resource_7ujpo"]
script = ExtResource("4_ihkt8")
_name = "Soldier"
short_description = "Disciplined fighter with military training."
long_description = "You have served with the Military and gained adequate military training as well as a proper education. After your service you get to keep your gear as reward for your service. However you are expected to report in at your nearest military post should get the call for duty. Skills: Discipline, Command, Melee Weapons, Ranged Weapons, Lore or Warfare. Equipment: Full set of Chain Mail or Leather Armor."

[sub_resource type="Resource" id="Resource_mcgc5"]
script = ExtResource("4_ihkt8")
_name = "Criminal"
short_description = "Streetwise rogue from a life outside the law."
long_description = "You have led a criminal life learning to talk your way out of sticky situations, sneaking in the dark and living life among the less honored. Skills: Speech, Stealth, Investigation, Sleight of Hand or Insight. Equipment: Bandits Outfit and Lockpick Set. Language: Thieves' Cant."

[sub_resource type="Resource" id="Resource_osuov"]
script = ExtResource("4_ihkt8")
_name = "Spy"
short_description = "Skilled infiltrator trained in intrigue."
long_description = "Employed by the Nation or a business, you've led a life of infiltration and intrigue, learning how to sneak around, read people and fit in. Skills: Stealth, Speech, Insight, Investigation, Acrobatics or Society. Equipment: An Outfit of your choice."

[sub_resource type="Resource" id="Resource_1emdm"]
script = ExtResource("4_ihkt8")
_name = "Noble"
short_description = "High-born individual with social standing."
long_description = "You are part of a Nobel family or have spent a significant portion of your life becoming one. A Nobel life comes with great social standing, understanding of money and perhaps even leadership skills. Skills: Discipline, Society, Command, Linguistics or Lore. Equipment: Nobels Attire and 100 Gold."

[sub_resource type="Resource" id="Resource_q26qn"]
script = ExtResource("4_ihkt8")
_name = "Farmer"
short_description = "Humble worker living off the land."
long_description = "You are a simple farmer, such a life teaches one how to interact with animals, living off the land, crafting what you need and humble understanding of people. Skills: Animal Handling, Insight, Survival, Craft or Athletics. Equipment: A weapon of Rarity 0."

[sub_resource type="Resource" id="Resource_j23e5"]
script = ExtResource("4_ihkt8")
_name = "Sage"
short_description = "Scholar steeped in knowledge and study."
long_description = "You are a kith of books and study. You possess a vast amount of knowledge on several subjects or perhaps specialized in a few. Skills: Lore, Medicine, Arcana, Investigation or Navigation. Equipment: Scribe's Robe."

[sub_resource type="Resource" id="Resource_fmtpq"]
script = ExtResource("4_ihkt8")
_name = "Acolyte"
short_description = "Devout follower with religious training."
long_description = "You are a kith of faith. An acolyte's life is spent learning about modesty and a deeper understanding of your religion. Skills: Discipline, Arcana, Lore, Speech or Medicine. Equipment: Priest's Garments."

[sub_resource type="Resource" id="Resource_8huku"]
script = ExtResource("4_ihkt8")
_name = "Entertainer"
short_description = "Performer who thrives in social settings."
long_description = "You are an entertainer traveling around, meeting people and enjoying the social aspects of life. Skills: Speech, Society, Insight, Acrobatics, Parry or Linguistics. Equipment: Performer's Outfit and an Instrument of Choice."

[sub_resource type="Resource" id="Resource_82828"]
script = ExtResource("4_ihkt8")
_name = "Artisan"
short_description = "Craftsman devoted to honing a trade."
long_description = "You are an artisan spending most of your life honing your craft. You might spend life becoming the best in one field or you might want to learn the basics of several. Skills: Society, Discipline, Sleight of Hand, Melee Weapons or Ranged Weapons. Equipment: Outfit of your choice and Crafting Tools of your choice."

[sub_resource type="Resource" id="Resource_gu0wo"]
script = ExtResource("4_ihkt8")
_name = "Mercenary"
short_description = "Seasoned fighter accustomed to hard travel."
long_description = "As a Mercenary you are familiar with combat, traveling and taking care of yourself. Skills: Acrobatics, Melee Weapons, Ranged Weapons, Survival, Medicine, Parry or Resistance. Equipment: Wanderer's Leather Clothing and a Weapon of Rarity 2 or lower."

[sub_resource type="Resource" id="Resource_vnmoj"]
script = ExtResource("4_ihkt8")
_name = "Pathfinder"
short_description = "Move faster on map."
long_description = "Travel time reduced in wilderness exploration."

[sub_resource type="Resource" id="Resource_bl2qw"]
script = ExtResource("4_ihkt8")
_name = "Trader"
short_description = "Wanderer of roads and markets, skilled at bargaining."
long_description = "As a Trader you are familiar with the life on the road or sea as well as you are socially adept. You might have traveled across the border into neighboring nations. Skills: Speech, Survival, Navigation or Insight."

[sub_resource type="Resource" id="Resource_2vvj5"]
script = ExtResource("4_ihkt8")
_name = "Pirate"
short_description = "Seafarer hardened by life on the waves."
long_description = "You have led a pirate's life learning to talk your way out of sticky situations, sailing on the open sea and living life among the less honored. Skills: Speech, Stealth, Sleight of Hand, Insight or Navigation. Equipment: Pirate's Attire."

[sub_resource type="Resource" id="Resource_u48dl"]
script = ExtResource("4_ihkt8")
_name = "Gladiator"
short_description = "Arena warrior trained for brutal combat."
long_description = "As a Gladiator you are familiar with combat and taking care of yourself. Skills: Warfare, Parry, Resistance or Athletics. Equipment: Tribal Outfit and a Weapon of Rarity 2 or lower."

[sub_resource type="Resource" id="Resource_7jvm8"]
script = ExtResource("4_ihkt8")
_name = "Hunter"
short_description = "Tracker and forager skilled in the wild."
long_description = "As a Hunter you are adept at tracking animals or gathering fruits and berries. Skills: Animal Handling, Discipline, Ranged Weapons or Melee Weapons. Equipment: Ranger's Outfit."

[sub_resource type="Resource" id="Resource_s36f1"]
script = ExtResource("4_ihkt8")
_name = "Elder"
short_description = "Wise figure recognized for knowledge and counsel."
long_description = "As an Elder of the tribe you possess more knowledge than most and can offer wisdom to those who need it. Elder is merely a title and does not reflect age, one is named Elder when one shows an aptitude for learning and is proven to be wise. Skills: Medicine, Lore, Survival, Animal Handling, Insight or Speech."

[sub_resource type="Resource" id="Resource_dyapp"]
script = ExtResource("4_ihkt8")
_name = "Beast Tamer"
short_description = "Handler skilled at taming and caring for animals."
long_description = "As a Beast Tamer you have had the responsibility of taming and keeping the animals of the tribe. Skills: Survival, Athletics, Acrobatics, Medicine or Insight."

[sub_resource type="Resource" id="Resource_m8tgl"]
script = ExtResource("4_ihkt8")
_name = "Dragon Knight"
short_description = "Elite warrior raised by the Dragon Knight Order."
long_description = "As a Dragon Knight you were brought up at one of the holds of the Dragon Knight Order. This could be because one or both your parents are a part of the order, because you lost your parents to a dragon attack at a young age or something else. Skills: Melee Weapons, Ranged Weapons, Lore, Acrobatics, Parry, Warfare or Medicine. Equipment: A set of Leather Armor or Scale Armor."

[sub_resource type="Resource" id="Resource_wc228"]
script = ExtResource("4_ihkt8")
_name = "Hermit"
short_description = "Solitary wanderer who chose a life apart."
long_description = "As a Hermit you have cast aside the stressful life among society for the preferable life of solitude. Skills: Survival, Lore, Arcana, Medicine or Discipline."

[sub_resource type="Resource" id="Resource_cdf4h"]
script = ExtResource("5_1j1y8")
_name = "Bleed"
short_description = "Taking ongoing damage."
long_description = "At the start of each round, this creature takes ongoing damage until the effect ends."

[sub_resource type="Resource" id="Resource_4v0je"]
script = ExtResource("5_1j1y8")
_name = "Prone"
short_description = "Knocked to the ground."
long_description = "Movement is hindered and melee and ranged attackers interact differently with the target."

[sub_resource type="Resource" id="Resource_tmbhf"]
script = ExtResource("5_1j1y8")
_name = "Stunned"
short_description = "Unable to act effectively."
long_description = "The creature is staggered and struggles to take meaningful action."

[sub_resource type="Resource" id="Resource_bvp8e"]
script = ExtResource("5_1j1y8")
_name = "Poisoned"
short_description = "Suffering from a toxic effect."
long_description = "The creature is weakened by poison and may take ongoing harm or penalties."

[sub_resource type="Resource" id="Resource_unnb6"]
script = ExtResource("5_1j1y8")
_name = "Burning"
short_description = "On fire."
long_description = "The creature is engulfed in flames and may take ongoing fire damage until the effect ends."

[sub_resource type="Resource" id="Resource_pn6fx"]
script = ExtResource("5_1j1y8")
_name = "Frozen"
short_description = "Slowed by intense cold."
long_description = "The creature is hampered by ice and severe cold, reducing mobility and responsiveness."

[sub_resource type="Resource" id="Resource_3jnol"]
script = ExtResource("5_1j1y8")
_name = "Grappled"
short_description = "Pinned or held in place."
long_description = "The creature is physically restrained and cannot move freely until it escapes."

[sub_resource type="Resource" id="Resource_qn0xc"]
script = ExtResource("5_1j1y8")
_name = "Frightened"
short_description = "Shaken by fear."
long_description = "The creature is mentally unsettled and may hesitate or struggle to approach the source of fear."

[sub_resource type="Resource" id="Resource_xj2gg"]
script = ExtResource("6_kyof1")
attribute1 = SubResource("Resource_75pra")
_name = "Deflection"

[sub_resource type="Resource" id="Resource_508ak"]
script = ExtResource("6_kyof1")
attribute1 = SubResource("Resource_lh87t")
attribute2 = SubResource("Resource_gc8h4")
_name = "Endurance"

[sub_resource type="Resource" id="Resource_bv352"]
script = ExtResource("6_kyof1")
attribute1 = SubResource("Resource_75pra")
attribute2 = SubResource("Resource_rdm6v")
_name = "Reflex"

[sub_resource type="Resource" id="Resource_rywu3"]
script = ExtResource("6_kyof1")
attribute1 = SubResource("Resource_qliu3")
attribute2 = SubResource("Resource_hcsc2")
_name = "Mind"

[sub_resource type="Resource" id="Resource_hdobw"]
script = ExtResource("7_5eegf")
_name = "The Ur'Holdum Jungle"
short_description = "Dense, perilous jungle where survival skills are second nature."
long_description = "You can choose one additional Tag skill among the following: Animal Handling, Survival or Medicine."

[sub_resource type="Resource" id="Resource_h87rk"]
script = ExtResource("7_5eegf")
_name = "The Orotari Kingdom"
short_description = "A refined kingdom where education and knowledge flourish."
long_description = "You can choose one additional Tag skill among the following: Society, Warfare or Discipline. Also gain a language of your choice."

[sub_resource type="Resource" id="Resource_4ijcn"]
script = ExtResource("7_5eegf")
_name = "The Frostheim Kingdom"
short_description = "Frozen lands where endurance against the cold is a way of life."
long_description = "You can increase your survival rating by 1.5 when it comes to exposure to cold weather. Also, you can reduce Freeze Effects on you by 1."

[sub_resource type="Resource" id="Resource_w8iyr"]
script = ExtResource("7_5eegf")
_name = "The Quasarian Empire"
short_description = "Harsh desert empire where heat and thirst shape daily survival."
long_description = "You can increase your survival rating by 1.5 when it comes to exposure to hot weather. You can go an hour longer for every stage of Thirst and hot weather does not halve it."

[sub_resource type="Resource" id="Resource_bj2lw"]
script = ExtResource("7_5eegf")
_name = "The Untamed Highlands"
short_description = "A patchwork of wild cities where adaptability is essential."
long_description = "Due to the many different cities in the Untamed Highlands, you've learned to adapt to different societies. During carousing you can re-roll 1d20 on your Society test."

[sub_resource type="Resource" id="Resource_0243t"]
script = ExtResource("7_5eegf")
_name = "Torgana Canyons"
short_description = "Harsh canyon homeland where only the strongest prevail."
long_description = "Once per scene, you can completely ignore one attack that targets you."

[sub_resource type="Resource" id="Resource_7losg"]
script = ExtResource("7_5eegf")
_name = "Calatherian Principality"
short_description = "Seafaring principality where piracy and trade intermingle."
long_description = "Whenever you successfully salvage an area, you also gain a free roll on the Oddities and Valuables table."

[sub_resource type="Resource" id="Resource_yoeu8"]
script = ExtResource("7_5eegf")
_name = "Asharati Forest"
short_description = "Deep, mystical woods where harmony with beasts is sacred."
long_description = "When you encounter a creature with the Beast Keyword, it will never attack you on sight. Also gain 1 re-roll on all Animal Handling tests."

[sub_resource type="Resource" id="Resource_rvoxu"]
script = ExtResource("7_5eegf")
_name = "No Homeland"
short_description = "Rootless wanderers who belong to no land or kingdom."
long_description = "When you choose to not have a homeland, you choose to belong to a different entity. Thus you will instead gain a Perk from Background."

[sub_resource type="Resource" id="Resource_7eklp"]
script = ExtResource("7_5eegf")
_name = "Aratori Dominion"
short_description = "Toxic, hazardous land where only hardened survivors thrive."
long_description = "Due to your upbringing in a hazardous land, you have learned to survive toxic and dangerous areas. When taking Hazard damage, you only take half."

[sub_resource type="Resource" id="Resource_wbwhm"]
script = ExtResource("7_5eegf")
_name = "The Obsidian Desert"
short_description = "Scorching desert where resilience to heat is vital."
long_description = "You can survive in hot weather without any penalty, and extreme hot weather is treated as hot weather."

