max_distance = 4
short_hand = "C"
id = 2
_name = "Close"
short_description = "Short ranged distance."
long_description = "Effective against targets within 2 to 4 hexes, suitable for close-quarters ranged combat."

[sub_resource type="Resource" id="Resource_eulau"]
