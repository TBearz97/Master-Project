[sub_resource type="Resource" id="Resource_juil0"]
script = ExtResource("228_40xes")
perk = SubResource("Resource_h7bi3")
_name = "Human"
short_description = "Adaptable and altruistic, humans excel at lifting others up."
long_description = "Humans are known for their good-natured spirit and cooperative drive. Their generosity inspires trust and camaraderie, and their versatility allows them to thrive in nearly any role. While they may lack the extremes of other races, their strength lies in supporting allies and amplifying group success."

[sub_resource type="Resource" id="Resource_srhp4"]
script = ExtResource("228_40xes")
perk = SubResource("Resource_b58qr")
_name = "Goliath"
short_description = "Towering survivors shaped by harsh lands."
long_description = "Goliaths embody raw strength and endurance, honed by unforgiving environments that demand physical superiority. Their imposing presence and resilience make them formidable in battle, but this focus comes at a cost—their agility and social grace often lag behind. Survival defines their culture, and strength is their creed."

[sub_resource type="Resource" id="Resource_utgke"]
script = ExtResource("228_40xes")
perk = SubResource("Resource_labk4")
_name = "High Elves"
short_description = "Charismatic masters of social influence."
long_description = "High Elves wield charm and eloquence as deftly as any weapon. Their natural poise and sophistication grant them an edge in diplomacy, persuasion, and subtle manipulation. While sometimes seen as proud or aloof, they navigate social structures with unmatched finesse, often bending situations to their favor."

[sub_resource type="Resource" id="Resource_65w0g"]
script = ExtResource("228_40xes")
perk = SubResource("Resource_6tdnd")
_name = "Dwarf"
short_description = "Stout folk guided by ancient runes."
long_description = "Every dwarf bears a rune that marks their destiny, weaving clan heritage with mystical power. Whether explorers driven by discovery, magisters deepened in arcane mastery, or artisans blessed with unmatched craft, dwarves live lives shaped by tradition and rune-bound fate. Hardy, loyal, and proud, they carry their culture as solidly as their stone-built halls."

[sub_resource type="Resource" id="Resource_0j31r"]
script = ExtResource("228_40xes")
perk = SubResource("Resource_f3jx2")
_name = "Halfling"
short_description = "Nimble and charming, but physically small."
long_description = "Halflings are quick-footed and warm-spirited, their small stature giving them an agility that belies their size. Loved for their charisma and adaptability, they thrive in both bustling towns and quiet villages. Yet their light build limits their strength and endurance, pushing them toward cleverness and community over brute force."

[sub_resource type="Resource" id="Resource_0ewof"]
script = ExtResource("228_40xes")
perk = SubResource("Resource_owwpf")
_name = "Ashborne"
short_description = "Volcanic-born beings clad in obsidian."
long_description = "Born of fire and forged in volcanic heartlands, Ashborne carry patches of living obsidian across their bodies. These hardened markings shield them from harm, embodying both their fiery origins and their resilience. Mysterious and formidable, they straddle the line between elemental power and mortal kin."

[sub_resource type="Resource" id="Resource_cv58u"]
script = ExtResource("228_40xes")
perk = SubResource("Resource_ipy2j")
_name = "Wood Elf"
short_description = "Children of the forest bound to nature."
long_description = "Wood Elves live in deep harmony with the natural world, their lives tied to the rhythm of the forest. Their herbivorous way of life strengthens their bond to the land, granting them resistance to disease and vitality from plant-based sustenance. Though gentle in outlook, their resilience comes from centuries of coexistence with wild and untamed realms."

[sub_resource type="Resource" id="Resource_8yx7x"]
script = ExtResource("228_40xes")
perk = SubResource("Resource_akr0u")
_name = "Orc"
short_description = "Hardy warriors with unyielding frames."
long_description = "Orcs are defined by resilience, their bodies forged with dense bones and iron will. Injury that would break others often spurs them onward, granting them fearsome reputations as warriors and survivors. Their culture prizes toughness and determination, values reflected in their enduring presence on battlefield and frontier alike."

[sub_resource type="Resource" id="Resource_0l2jc"]
script = ExtResource("228_40xes")
perk = SubResource("Resource_8cgvh")
_name = "Husk-Folk"
short_description = "Soul-deprived beings sustained by death’s touch."
long_description = "The Husk-Folk are eerie figures, hollowed of soul yet animated by a strange vitality. Where necrotic forces drain others, these beings draw strength, healing in the presence of decay. Neither fully dead nor alive, they stand apart from mortal kin, unsettling yet undeniably powerful in their bond to the energies of death."

[sub_resource type="Resource" id="Resource_eqshn"]
script = ExtResource("229_41nax")
expression = "rollDice(1, difficulty) <= skill"
_name = "Skill Check"

[sub_resource type="Resource" id="Resource_h7bmi"]
script = ExtResource("229_41nax")
expression = "min(player_level + 2, 10)"
_name = "Skill Cap"

[sub_resource type="Resource" id="Resource_2kn15"]
script = ExtResource("230_s18lo")
_name = "Animal Handling"
short_description = "The bond between mortal and beast."
long_description = "Animal handling is the art of trust and instinct, guiding creatures through patience rather than force. It is the steady hand that calms a frightened steed, the subtle command that turns a hound against its quarry, and the quiet respect that earns loyalty from claw and fang alike."

[sub_resource type="Resource" id="Resource_y7a43"]
script = ExtResource("230_s18lo")
_name = "Athletics"
short_description = "The measure of strength, speed, and stamina in motion."
long_description = "Athletics is the discipline of the body pushed to its limits — running, climbing, leaping, and enduring trials that test both muscle and breath. It is the difference between faltering on the field and pressing forward with unyielding vigor."

[sub_resource type="Resource" id="Resource_eijmd"]
script = ExtResource("230_s18lo")
_name = "Command"
short_description = "The voice that moves others to act."
long_description = "Command is the force of presence that rallies companions and bends wills to a common cause. It is found in the calm orders given in battle, the unshakable confidence that inspires courage, and the steady gaze that compels obedience without question."

[sub_resource type="Resource" id="Resource_5svdx"]
script = ExtResource("230_s18lo")
_name = "Craft"
short_description = "The shaping of raw material into lasting form."
long_description = "Craft is the skill of hands guided by knowledge, turning wood, stone, or steel into tools, weapons, and works of art. It is patience, precision, and creativity bound together, leaving behind works that endure beyond their maker’s lifetime."

[sub_resource type="Resource" id="Resource_q63j6"]
script = ExtResource("230_s18lo")
_name = "Insight"
short_description = "The ability to read truth in others."
long_description = "Insight is the quiet observation of subtle gestures, unspoken words, and hidden motives. It is the wisdom to look beyond appearances, discerning intent from shadow and sincerity from deceit."

[sub_resource type="Resource" id="Resource_xmq52"]
script = ExtResource("230_s18lo")
_name = "Investigation"
short_description = "The pursuit of hidden answers through reason."
long_description = "Investigation is the patient unraveling of mystery — studying clues, tracing patterns, and connecting fragments until the truth emerges. It is the art of the inquisitive mind, leaving no stone unturned and no secret concealed for long."

[sub_resource type="Resource" id="Resource_g80yu"]
script = ExtResource("230_s18lo")
_name = "Lore"
short_description = "The memory of stories, histories, and knowledge."
long_description = "Lore is the collection of all that has been learned and passed down: myths and histories, secrets of the land, and wisdom preserved through generations. Those versed in lore hold the keys to understanding both the past and the present."

[sub_resource type="Resource" id="Resource_rjdvq"]
script = ExtResource("230_s18lo")
_name = "Medicine"
short_description = "The art of healing and preserving life."
long_description = "Medicine is the knowledge of flesh and spirit, of how wounds may be closed and ailments eased. It is the healer’s craft, restoring strength where it has faltered and warding off the grasp of death itself."

[sub_resource type="Resource" id="Resource_qqckq"]
script = ExtResource("230_s18lo")
_name = "Sleight of Hand"
short_description = "The art of swift, subtle fingers."
long_description = "Sleight of hand is dexterity made invisible — a coin vanished, a purse lifted, a dagger drawn before the eye can follow. It is trickery and finesse, both performance and deception."

[sub_resource type="Resource" id="Resource_1pg1f"]
script = ExtResource("230_s18lo")
_name = "Society"
short_description = "The understanding of order, law, and custom."
long_description = "Society is the study of how people live together: their structures of power, their traditions, their spoken and unspoken rules. One skilled in society can navigate courts and markets alike, finding their place among folk of every station."

[sub_resource type="Resource" id="Resource_dvuba"]
script = ExtResource("230_s18lo")
_name = "Speech"
short_description = "The art of words given power."
long_description = "Speech is the craft of persuasion, the ability to sway hearts and shape minds with voice alone. From rousing orations to whispered bargains, it is the force that builds alliances and bends destiny."

[sub_resource type="Resource" id="Resource_wmw2b"]
script = ExtResource("230_s18lo")
_name = "Stealth"
short_description = "The shadow’s embrace, unseen and unheard."
long_description = "Stealth is the skill of moving in silence, slipping past notice, and striking unseen. It is patience, precision, and the discipline to become part of the darkness itself."

[sub_resource type="Resource" id="Resource_0frkd"]
script = ExtResource("230_s18lo")
_name = "Survival"
short_description = "The knowledge to endure the wilds."
long_description = "Survival is the understanding of nature’s dangers and gifts — how to find water, build shelter, track game, and weather storm or famine. It is the art of living where the land itself may seek to claim you."

