[sub_resource type="Resource" id="Resource_h7bi3"]
script = ExtResource("4_wtekf")
category = "Race"
_name = "Good Natured"
short_description = "Share your full expertise when aiding allies, gaining the same rewards."
long_description = "Your kind-hearted and altruistic nature inspires and empowers your companions, allowing you to lend your full expertise to support them in their endeavors. When aiding another character you add your entire skill bonus rather than half. Any IP generated from that test you also gain."

[sub_resource type="Resource" id="Resource_b58qr"]
script = ExtResource("4_wtekf")
category = "Race"
_name = "Unyielding"
short_description = "Reduce knockback."
long_description = "Become harder to stagger or push back from hits."

[sub_resource type="Resource" id="Resource_0qbgw"]
script = ExtResource("4_wtekf")
category = "Race"
_name = "Social Beings"
short_description = "Naturally persuasive, gaining a boost in conversations."
long_description = "With an innate charm and eloquence, High Elves effortlessly navigate social landscapes, bending conversations to their will with ease and finesse. High Elves have a knack for getting what they want in conversations, gain a +2 Social Modifier."

[sub_resource type="Resource" id="Resource_6tdnd"]
script = ExtResource("4_wtekf")
category = "Race"
_name = "Runic Destiny"
short_description = "Each rune grants unique powers of luck, magic, or craft."
long_description = "From the moment of birth, every Dwarf bears a unique rune etched into their body, signifying their clan and heritage. These mystical runes are not just marks of identity; they bestow powerful benefits that shape the destiny of each Dwarf.\\n\\nExplorer's Rune\\nMarked by the Explorer's Rune, your fate is intertwined with fortune and discovery. The rune guides your hand, ensuring you find the best rewards on your journeys. Every time you roll on a loot table, roll twice and choose the outcome.\\n\\nMagister's Rune\\nThe Magister's Rune bestows upon you an innate mastery of mystical arts. This rune amplifies your connection to the magical realms, enhancing your spellcasting and mystical insights. You gain an extra Tag in either Arcana, Shamanism or Zeal.\\n\\nArtisan's Rune\\nBearing the Artisan's Rune, your hands are gifted with extraordinary skill. This rune enhances your craftsmanship, making anything you create a testament to your exceptional talent. You gain Tag in Craft and a +2 for any skill test where you are using something you made your self."

[sub_resource type="Resource" id="Resource_f3jx2"]
script = ExtResource("4_wtekf")
category = "Race"
_name = "Nimble Escape"
long_description = "Your small frame and quick instincts make it difficult to pin you down. When moving out of melee with only one opponent threatening you, the extra AP cost does not apply."

[sub_resource type="Resource" id="Resource_owwpf"]
script = ExtResource("4_wtekf")
category = "Race"
_name = "From Fire and Flame"
short_description = "Obsidian patches grant immunity to damage in one chosen spot."
long_description = "Forged in the heart of a volcano, your body is adorned with obsidian patches that render you impervious to harm, a testament to your fiery origin. Your body grows magical Obsidian patches around your body, choose one location where they have converged making you entirely immune to damage."

[sub_resource type="Resource" id="Resource_ipy2j"]
script = ExtResource("4_wtekf")
category = "Race"
_name = "Forest Child"
short_description = "Plant-based diet grants immunity to disease and better nourishment."
long_description = "Living in harmony with nature, your diet is strictly herbivorous. This bond with the forest grants you immunity to disease and enhanced nourishment from plant-based foods. You can't eat meat, if you do you Max Health is reduced by 25% until a you've had a full nights rest. You are also immune to diseases and all other food gives you double benefit."

[sub_resource type="Resource" id="Resource_akr0u"]
script = ExtResource("4_wtekf")
category = "Race"
_name = "We Endure"
long_description = "Life is harsh, and your people are shaped by enduring it. During each full rest, you may either heal one additional Injury or reduce the duration of one disease by an additional step."

[sub_resource type="Resource" id="Resource_8cgvh"]
script = ExtResource("4_wtekf")
category = "Race"
_name = "Soulless"
short_description = "Necrotic damage heals you instead of harming you."
long_description = "Devoid of a soul, the forces of necrosis that would harm others instead rejuvenate you, turning death itself into a source of strength. You are immune to necrotic damage. In fact, you’re healed by it, you regain half of the necrotic damage inflicted upon you."

[sub_resource type="Resource" id="Resource_n4jyj"]
script = ExtResource("4_wtekf")
category = "Survival and Field"
_name = "Forager"
short_description = "Gather more resources."
long_description = "Find additional herbs, food, and crafting materials."

[sub_resource type="Resource" id="Resource_w62fx"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Weapon Proficiency"
long_description = "Requirement: Level 2\\\\n\\\\nChoose one weapon type. You gain access to that weapon's Proficiency attacks."

[sub_resource type="Resource" id="Resource_ayf3t"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Weapon Expertise"
long_description = "Requirement: Weapon Proficiency with the chosen weapon, Level 10\\\\n\\\\nChoose one weapon type in which you already have Weapon Proficiency. You gain access to that weapon's Expertise attacks."

[sub_resource type="Resource" id="Resource_bo3qe"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Weapon Mastery"
short_description = "Increase proficiency with chosen weapon type."
long_description = "Gain improved control and critical chance with a selected weapon class."

[sub_resource type="Resource" id="Resource_m4b8c"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Quick Swap"
long_description = "Requirement: Weapon Proficiency, Dexterity 6\\\\n\\\\nOnce per round, you may swap loadouts or ready a different weapon as a free action."

[sub_resource type="Resource" id="Resource_m0dmn"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Master at Arms"
long_description = "Requirement: Quick Swap, Level 4\\\\n\\\\nYou gain one additional weapon loadout."

[sub_resource type="Resource" id="Resource_b54b3"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Dual Wielder"
long_description = "Requirement: Dexterity 6\\\\n\\\\nWhen fighting with a one-handed weapon in each hand, the first off-hand attack you make each round costs 1 less AP."

[sub_resource type="Resource" id="Resource_j010n"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Duelist"
long_description = "Requirement: Dexterity 7, Weapon Proficiency with a one-handed melee weapon\\\\n\\\\nWhile wielding a single one-handed melee weapon and no shield, gain +1 Deflection."

[sub_resource type="Resource" id="Resource_iojns"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Riposte"
long_description = "Requirement: Duelist, Level 5\\\\n\\\\nThe first time each round a creature misses you with a melee attack, your next melee attack against that creature gains +1 Accuracy and deals 10% more damage."

[sub_resource type="Resource" id="Resource_vnboh"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Accurate"
long_description = "Requirement: Perception 6\\\\n\\\\nOnce each round, you may re-roll 1d20 on an attack made with a weapon you have proficiency in."

[sub_resource type="Resource" id="Resource_avfv7"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Center of Mass"
long_description = "Requirement: Accurate, Level 4\\\\n\\\\nWhen you make a ranged attack against a creature within the weapon's normal range, gain +1 Accuracy."

[sub_resource type="Resource" id="Resource_qh5qs"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Bull's Eye"
long_description = "Requirement: Center of Mass, Level 7\\\\n\\\\nThe first ranged attack you make each round gains +1 Crit Die size."

[sub_resource type="Resource" id="Resource_xa2d3"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Giant's Grip"
long_description = "Requirement: Might 7\\\\n\\\\nYou can wield a two-handed melee weapon in one hand for the purpose of carrying or readying it, but you still need two hands to use its attacks unless another rule says otherwise."

[sub_resource type="Resource" id="Resource_gv0fg"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Hold the Line"
long_description = "Requirement: Might 6, Constitution 6\\\\n\\\\nCreatures provoke 1 additional AP to move out of your Reach."

[sub_resource type="Resource" id="Resource_k5s5j"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Heavy Armor Master"
long_description = "Requirement: Might 7, Constitution 6, Level 5\\\\n\\\\nWhile in Heavy Load, gain +1 Physical DT."

[sub_resource type="Resource" id="Resource_g8f55"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Mage Slayer"
long_description = "Requirement: Resolve 6, Level 5\\\\n\\\\nWhen you damage a creature that currently has Concentration, reduce its Concentration by 1. This can only happen once per turn."

[sub_resource type="Resource" id="Resource_4fatp"]
script = ExtResource("4_wtekf")
category = "Weapon"
_name = "Fast Hands"
long_description = "Requirement: Dexterity 6\\\\n\\\\nThe first Interact action you take each round costs 1 less AP, to a minimum of 1."

[sub_resource type="Resource" id="Resource_in67y"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Magical Student"
long_description = "Requirement: Intelligence 6, Lore 2\\\\n\\\\nLearn Theoretical spells through study and observation, gaining permanent access to all spells recorded in your spellbook without needing preparation."

[sub_resource type="Resource" id="Resource_4v3u0"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Patronage"
long_description = "Requirement: Resolve 6\\\\n\\\\nGain spells from any school through deals, sacrifices, and narrative events, with your power shaped and potentially altered by your patron."

[sub_resource type="Resource" id="Resource_xeion"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Conviction"
short_description = "Resist fear and charm."
long_description = "Unshakeable faith grants immunity to fear and control effects."

[sub_resource type="Resource" id="Resource_irq6k"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Ritualist"
long_description = "Requirement: Resolve 6, Survival 2 or Lore 2\\\\n\\\\nSelect a limited number of Primal spells after performing a ritual, allowing you to change your available spells during a full rest."

[sub_resource type="Resource" id="Resource_0gh3k"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Innate Power"
long_description = "Requirement: Resolve 6\\\\n\\\\nChoose a magical keyword, such as Fire, Illusion, or Necrotic. You learn matching spells from any school, with a limited number of permanently known spells that grows as you level."

[sub_resource type="Resource" id="Resource_31f75"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Font of Mana"
long_description = "Requirement: Resolve 7\\\\n\\\\nIncrease your maximum Mana by 2."

[sub_resource type="Resource" id="Resource_vqtfl"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Quiet Casting"
long_description = "Requirement: Any magical identity perk, Level 3\\\\n\\\\nTests made to notice your spellcasting become harder unless the spell is especially loud, bright, or destructive."

[sub_resource type="Resource" id="Resource_r1jli"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Mind Fortress"
long_description = "Requirement: Resolve 7, Level 4\\\\n\\\\nGain +1 Concentration."

[sub_resource type="Resource" id="Resource_6x1ku"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Spellsword"
long_description = "Requirement: Any magical identity perk, Weapon Proficiency, Level 4\\\\n\\\\nChoose one weapon type you have Weapon Proficiency with. That weapon counts as a casting focus for you, and the first time each round you deal damage with it you gain 1 Mana."

[sub_resource type="Resource" id="Resource_7cl47"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Pyromaniac"
long_description = "Requirement: Ability to deal Fire damage\\\\n\\\\nYou deal 10% more damage against targets that are on fire. If a single attack or spell affects more than one target that is on fire, increase the damage by an additional 10% for each extra burning target, up to 30% total."

[sub_resource type="Resource" id="Resource_gw1i1"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Fire Starter"
long_description = "Requirement: Ability to deal Fire damage\\\\n\\\\nThe first time each round you deal Fire damage, you may re-roll 1d20 on one Fire-related damage or effect roll tied to that action. If the table does not use such a roll, that attack or spell instead deals 10% more damage."

[sub_resource type="Resource" id="Resource_tdv0i"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Cryo-Expert"
long_description = "Requirement: Ability to deal Freeze damage or use Ice magic\\\\n\\\\nCreatures affected by your Ice or Freeze effects are easier to keep controlled. The first time each round you inflict Freeze, the target also loses 1 AP."

[sub_resource type="Resource" id="Resource_uh3vk"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Necrosis"
long_description = "Requirement: Ability to deal Necrotic damage\\\\n\\\\nWhen you deal Necrotic damage, ignore 1 Necrotic DT."

[sub_resource type="Resource" id="Resource_ck0fb"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Deliberate Strikes"
long_description = "Requirement: Perception 6\\\\n\\\\nWhenever one of your attacks scores a critical hit, gain 1 Mana."

[sub_resource type="Resource" id="Resource_roorf"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Crits on Crits"
long_description = "Requirement: Deliberate Strikes, Perception 8, Level 8\\\\n\\\\nWhen one of your Crit Dice rolls its highest value, roll one additional Crit Die of the same size and add it. Dice generated by this perk cannot generate further Crit Dice."

[sub_resource type="Resource" id="Resource_8mh2x"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Bloodlust"
long_description = "Requirement: Might 6 or Resolve 6\\\\n\\\\nWhen you deal 5 or more HP damage with a single attack or spell, gain 1 Mana. If you deal 10 or more HP damage, gain 2 Mana instead. You cannot gain more than 2 Mana per turn from this perk."

[sub_resource type="Resource" id="Resource_83kd0"]
script = ExtResource("4_wtekf")
category = "Magic"
_name = "Hemomancy"
long_description = "Requirement: Resolve 6, Level 4\\\\n\\\\nWhen you suffer 5 or more HP damage from a single source, gain 1 Mana. If you suffer 10 or more HP damage, gain 2 Mana instead. You cannot gain more than 2 Mana per turn from this perk."

[sub_resource type="Resource" id="Resource_twuj3"]
script = ExtResource("4_wtekf")
category = "Leadership and Social"
_name = "War Cry"
long_description = "Requirement: Command 2\\\\n\\\\nOnce per scene, when combat begins, one ally who can hear you gains +1 AP on their first turn."

[sub_resource type="Resource" id="Resource_dqr4r"]
script = ExtResource("4_wtekf")
category = "Leadership and Social"
_name = "Born Leader"
long_description = "Requirement: Command 3, Resolve 6\\\\n\\\\nWhen you Assist an ally, they may use your full Command rank instead of half your skill bonus."

[sub_resource type="Resource" id="Resource_m7esd"]
script = ExtResource("4_wtekf")
category = "Leadership and Social"
_name = "Commanding Presence"
short_description = "Boost ally morale."
long_description = "Nearby allies gain courage when you speak."

[sub_resource type="Resource" id="Resource_0ewdf"]
script = ExtResource("4_wtekf")
category = "Leadership and Social"
_name = "Terrifying Presence"
long_description = "Requirement: Might 6 or Command 2\\\\n\\\\nWhen you try to intimidate a creature, you may use Might instead of Speech if your threat is based on force or physical menace."

[sub_resource type="Resource" id="Resource_u0l7g"]
script = ExtResource("4_wtekf")
category = "Leadership and Social"
_name = "Read the Room"
long_description = "Requirement: Insight 2\\\\n\\\\nWhen you enter a social scene, you may ask the GM for the dominant mood, pressure, or tension in the room."

[sub_resource type="Resource" id="Resource_8w6aq"]
script = ExtResource("4_wtekf")
category = "Leadership and Social"
_name = "Body Language"
long_description = "Requirement: Insight 3\\\\n\\\\nTests to notice lies, fear, hidden hostility, or hesitation become easier for you."

[sub_resource type="Resource" id="Resource_efr8p"]
script = ExtResource("4_wtekf")
category = "Leadership and Social"
_name = "Voice of Reason"
long_description = "Requirement: Speech 2\\\\n\\\\nOnce per scene, when you try to calm panic, defuse conflict, or stop a rash decision, re-roll 1d20 on the test."

[sub_resource type="Resource" id="Resource_m7e5y"]
script = ExtResource("4_wtekf")
category = "Leadership and Social"
_name = "Barter"
long_description = "Requirement: Speech 2, Society 2\\\\n\\\\nWhen you negotiate prices, gain a 10% discount on ordinary legal goods unless a stronger rule already applies."

[sub_resource type="Resource" id="Resource_5embg"]
script = ExtResource("4_wtekf")
category = "Leadership and Social"
_name = "Diplomat"
short_description = "Win favor among nobles."
long_description = "Speak with authority to gain favor in upper circles."

[sub_resource type="Resource" id="Resource_ebhi1"]
script = ExtResource("4_wtekf")
category = "Leadership and Social"
_name = "Inner Circle"
long_description = "Requirement: Society 2\\\\n\\\\nIn courts, guilds, temples, or other structured groups, you are better at identifying who really holds influence."

[sub_resource type="Resource" id="Resource_fgm8a"]
script = ExtResource("4_wtekf")
category = "Leadership and Social"
_name = "Leveraging Status"
long_description = "Requirement: Society 3\\\\n\\\\nIf you have positive Renown in the current culture or faction, gain +2 on your first related social test each scene."

[sub_resource type="Resource" id="Resource_e3xnd"]
script = ExtResource("4_wtekf")
category = "Leadership and Social"
_name = "Black Market"
long_description = "Requirement: Society 2 or Stealth 2\\\\n\\\\nTests made to find illegal, hidden, or restricted goods become easier."

[sub_resource type="Resource" id="Resource_c86jw"]
script = ExtResource("4_wtekf")
category = "Leadership and Social"
_name = "I Belong Here"
long_description = "Requirement: Society 2 or Stealth 2\\\\n\\\\nWhen trying to pass as part of a crowd, workplace, or social function, the first test to challenge your presence becomes harder."

[sub_resource type="Resource" id="Resource_y1o4w"]
script = ExtResource("4_wtekf")
category = "Knowledge and Craft"
_name = "Tricks of the Trade"
long_description = "Requirement: Craft 2\\\\n\\\\nChoose one field of craft such as alchemy, smithing, bowyering, tailoring, tinkering, or writing. Tests in that field become easier."

[sub_resource type="Resource" id="Resource_ge1i1"]
script = ExtResource("4_wtekf")
