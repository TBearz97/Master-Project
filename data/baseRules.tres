[sub_resource type="Resource" id="Resource_5m5ye"]
script = ExtResource("1_j010n")
value = 1
bonus_1_prefix = "Damage & Healing:"
bonus_2_prefix = "Carry Weight:"
bonus_1_expression = "(x - 1) * 5"
bonus_2_expression = "((x - 1) * 5) + 75"
bonus_1_suffix = "%"
bonus_2_suffix = "kg"
_name = "Might"
short_description = "Represents physical and spiritual strength."
long_description = "Might measures the character’s raw physical and inner power. It influences both physical and magical damage as well as the effectiveness of healing abilities. Characters with higher Might deal and heal more damage and can carry heavier loads."

[sub_resource type="Resource" id="Resource_84sj7"]
script = ExtResource("1_j010n")
value = 1
bonus_1_prefix = "Action Points:"
bonus_2_prefix = "Deflection:"
bonus_1_expression = "x + 3"
bonus_2_expression = "x"
_name = "Dexterity"
short_description = "Represents speed, coordination, and reflexes."
long_description = "Dexterity reflects a character’s agility and precision in both physical and mental actions. It governs how quickly and efficiently a character can move, attack, and react. High Dexterity grants additional action points, allowing more actions per turn, and improves deflection, helping to avoid incoming attacks."

[sub_resource type="Resource" id="Resource_itu0m"]
script = ExtResource("1_j010n")
value = 1
bonus_1_prefix = "Health:"
bonus_2_prefix = "Vitality:"
bonus_1_expression = "x + 5"
bonus_2_expression = "(3 + floor((x - 1) / 3))"
bonus_1_suffix = "x Level"
bonus_2_suffix = "x Health"
_name = "Constitution"
short_description = "Represents endurance and overall toughness."
long_description = "Constitution determines a character’s physical resilience and ability to withstand harm, fatigue, and disease. It directly affects maximum health and long-term vitality, influencing how long a character can endure in battle or harsh environments. Those with higher Constitution can take more punishment and recover faster from strain."

[sub_resource type="Resource" id="Resource_dk6t0"]
