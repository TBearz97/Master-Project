_name = "Farmer"
short_description = "Hardworking individual accustomed to life on the land."
long_description = "You lived close to the earth, working with your hands to sustain yourself and others. Your life taught patience, resilience, and a grounded understanding of nature and community."

[sub_resource type="Resource" id="Resource_ey5bm"]
