long_description = "Tests to bypass locks, simple security, or unnoticed entry become easier."

[sub_resource type="Resource" id="Resource_4qofv"]
script = ExtResource("25_p40pa")
perk = SubResource("Resource_tv08y")
id = 1
_name = "Human"
short_description = "Adaptable and cooperative people who thrive in diverse roles."
long_description = "Humans are known for their flexibility, ambition, and strong sense of community. They build connections easily and often succeed through cooperation and persistence. Rather than excelling in a single extreme, their strength lies in their ability to adapt, support others, and find opportunity in changing circumstances."

[sub_resource type="Resource" id="Resource_iv7u6"]
script = ExtResource("25_p40pa")
perk = SubResource("Resource_uhbrm")
id = 2
_name = "Goliath"
short_description = "Towering people shaped by harsh environments and physical endurance."
long_description = "Goliaths are defined by their size, strength, and resilience, traits forged in unforgiving lands where only the toughest survive. Their culture values perseverance and self-reliance, often placing physical capability above all else. While imposing and formidable, they can struggle with subtlety and social nuance."

[sub_resource type="Resource" id="Resource_murt2"]
script = ExtResource("25_p40pa")
perk = SubResource("Resource_r2vid")
id = 3
_name = "High Elf"
short_description = "Refined and long-lived people devoted to mastery and tradition."
long_description = "High Elves are known for their discipline, elegance, and deep cultural heritage. Their long lives allow them to pursue mastery over arts, knowledge, and society itself. They often carry an air of quiet superiority, shaped by centuries of refinement and a strong connection to their lineage."

[sub_resource type="Resource" id="Resource_t76r4"]
script = ExtResource("25_p40pa")
perk = SubResource("Resource_qkt6c")
id = 4
_name = "Dwarf"
short_description = "Stout people guided by ancient traditions and inherited purpose."
long_description = "Dwarves live lives steeped in tradition, where heritage and identity are closely intertwined. Their societies are built on loyalty, craftsmanship, and a deep respect for the past. Each individual carries a sense of purpose shaped by their lineage, and their culture is as enduring as the stone they favor."

[sub_resource type="Resource" id="Resource_wyiyj"]
script = ExtResource("25_p40pa")
perk = SubResource("Resource_vapoo")
id = 5
_name = "Halfling"
short_description = "Small, agile people known for charm and resourcefulness."
long_description = "Halflings are quick, clever, and naturally sociable. Their size encourages agility and adaptability, allowing them to navigate the world through wit and cooperation rather than force. They value comfort, companionship, and clever solutions to life’s challenges."

[sub_resource type="Resource" id="Resource_7e574"]
script = ExtResource("25_p40pa")
perk = SubResource("Resource_ckgvd")
id = 6
_name = "Ashborne"
short_description = "Volcanic-born beings marked by obsidian and inner fire."
long_description = "Ashborne are shaped by volcanic origins, their bodies bearing hardened traces of the environments that birthed them. Their presence is striking and often intimidating, reflecting a balance between elemental force and mortal will. They carry an intensity that mirrors the landscapes they come from."

[sub_resource type="Resource" id="Resource_0mp3h"]
script = ExtResource("25_p40pa")
perk = SubResource("Resource_x4hts")
id = 7
_name = "Wood Elf"
short_description = "Forest-dwelling people deeply connected to the natural world."
long_description = "Wood Elves live in close harmony with nature, shaping their lives around the rhythms of the land. Their culture emphasizes balance, respect, and coexistence with the environment. They are often seen as calm and deliberate, guided by a long-standing relationship with the wild."

[sub_resource type="Resource" id="Resource_gs3oi"]
script = ExtResource("25_p40pa")
perk = SubResource("Resource_4ra5h")
id = 8
_name = "Orc"
short_description = "Resilient people defined by toughness and determination."
long_description = "Orcs are known for their physical durability and unyielding nature. Their culture values strength, endurance, and the ability to persevere through hardship. Whether in conflict or survival, they are relentless, often pushing forward where others would falter."

[sub_resource type="Resource" id="Resource_l4whq"]
script = ExtResource("25_p40pa")
perk = SubResource("Resource_pfcfl")
id = 9
_name = "Husk-Folk"
short_description = "Unsettling beings caught between life and death."
long_description = "Husk-Folk exist in a strange state between the living and the dead, their presence often evoking unease. They are sustained by forces others fear, giving them an unusual perspective on existence. Isolated from most societies, they embody a quiet, haunting resilience."

[sub_resource type="Resource" id="Resource_8likl"]
