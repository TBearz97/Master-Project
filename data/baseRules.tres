category = "Weapon"
requirement_text = "Requirement: Dexterity 6"
id = 45
_name = "Dual Wielder"
short_description = "Reduce the AP cost of the first off-hand attack."
long_description = "When fighting with a one-handed weapon in each hand, the first off-hand attack you make each round costs 1 less AP."

[sub_resource type="Resource" id="Resource_a6pdv"]
