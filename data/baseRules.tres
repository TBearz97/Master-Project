[sub_resource type="Resource" id="Resource_bvh3n"]
script = ExtResource("5_5qo2o")
id = 1
_name = "Damage & Healing"
short_description = "Affects damage and healing output."
long_description = "Damage & Healing modifies how much damage you deal and how much healing you provide. Higher values increase both offensive and restorative effectiveness."

[sub_resource type="Resource" id="Resource_rq3ee"]
script = ExtResource("5_5qo2o")
id = 2
_name = "Max Carry Weight"
short_description = "Increases carrying capacity."
long_description = "Max Carry Weight determines how much equipment and items a character can carry before becoming encumbered. Higher values allow heavier loads."

[sub_resource type="Resource" id="Resource_4ofg7"]
script = ExtResource("4_diqh5")
modifier_1 = SubResource("Resource_bvh3n")
modifier_1_expression = "(x - 5) * 7"
modifier_2 = SubResource("Resource_rq3ee")
modifier_2_expression = "(x * 10) + 45"
min_value = 1
max_value = 10
id = 1
_name = "Might"
short_description = "Represents physical and spiritual strength."
long_description = "Might measures the character’s raw physical and inner power. It influences both physical and magical damage as well as the effectiveness of healing abilities. Characters with higher Might deal and heal more damage and can carry heavier loads."

[sub_resource type="Resource" id="Resource_fpcfp"]
script = ExtResource("5_5qo2o")
id = 3
_name = "Action Points"
short_description = "Determines available actions per turn."
long_description = "Action Points represent how many actions a character can take during their turn. Increasing this value allows for more actions each round."

[sub_resource type="Resource" id="Resource_5lpto"]
script = ExtResource("5_5qo2o")
id = 4
_name = "Deflection"
short_description = "Improves chance to avoid attacks."
long_description = "Deflection determines how difficult it is for enemies to land weapon attacks against you. Higher Deflection increases your chance to avoid incoming attacks."

[sub_resource type="Resource" id="Resource_wpnqb"]
script = ExtResource("4_diqh5")
modifier_1 = SubResource("Resource_fpcfp")
modifier_1_expression = "x + 6 - floor(x / 4)"
modifier_2 = SubResource("Resource_5lpto")
modifier_2_expression = "x"
min_value = 1
max_value = 10
id = 2
_name = "Dexterity"
short_description = "Represents speed, coordination, and reflexes."
long_description = "Dexterity reflects a character’s agility and precision in both physical and mental actions. It governs how quickly and efficiently a character can move, attack, and react. High Dexterity grants additional action points, allowing more actions per turn, and improves deflection, helping to avoid incoming attacks."

[sub_resource type="Resource" id="Resource_rsohl"]
script = ExtResource("5_5qo2o")
id = 5
_name = "Health"
short_description = "Determines total health pool."
long_description = "Health represents the total amount of damage a character can sustain before being incapacitated. Increasing Health improves survivability."

[sub_resource type="Resource" id="Resource_hgj4n"]
script = ExtResource("5_5qo2o")
id = 6
_name = "Vitality"
short_description = "Represents endurance and recovery."
long_description = "Vitality reflects overall stamina and recovery capability, influencing how well a character endures prolonged activity and recovers from strain."

[sub_resource type="Resource" id="Resource_m1dg0"]
script = ExtResource("4_diqh5")
modifier_1 = SubResource("Resource_rsohl")
modifier_1_expression = "(x + 5) * level"
modifier_2 = SubResource("Resource_hgj4n")
modifier_2_expression = "(1 + ceil(x / 3.0)) * health"
min_value = 1
max_value = 10
id = 3
_name = "Constitution"
short_description = "Represents endurance and overall toughness."
long_description = "Constitution determines a character’s physical resilience and ability to withstand harm, fatigue, and disease. It directly affects maximum health and long-term vitality, influencing how long a character can endure in battle or harsh environments. Those with higher Constitution can take more punishment and recover faster from strain."

[sub_resource type="Resource" id="Resource_2rvds"]
script = ExtResource("5_5qo2o")
id = 7
_name = "Accuracy"
short_description = "Improves chance to hit targets."
long_description = "Accuracy determines how likely an attack is to successfully hit its target. Higher Accuracy reduces the chance of missing."

[sub_resource type="Resource" id="Resource_8uuax"]
script = ExtResource("5_5qo2o")
id = 8
_name = "Crit Dice"
short_description = "Increases critical damage potential."
long_description = "Crit Dice increases the number or effectiveness of dice rolled when scoring a critical hit, leading to higher burst damage potential."

[sub_resource type="Resource" id="Resource_yftm0"]
script = ExtResource("4_diqh5")
modifier_1 = SubResource("Resource_2rvds")
modifier_1_expression = "x + 2"
modifier_2 = SubResource("Resource_8uuax")
modifier_2_expression = "2 * ceil(x / 2.0) + 2"
min_value = 1
max_value = 10
id = 4
_name = "Perception"
short_description = "Represents awareness and precision."
long_description = "Perception measures a character’s ability to notice details, aim accurately, and react swiftly to subtle changes in their surroundings. High Perception increases accuracy with all attacks and improves the likelihood of striking vital points, resulting in more devastating critical hits."

[sub_resource type="Resource" id="Resource_1e8n2"]
script = ExtResource("5_5qo2o")
id = 9
_name = "Potency"
short_description = "Enhances effect strength and duration."
long_description = "Potency enhances the strength, effectiveness, and sometimes duration of abilities, spells, and effects applied to targets."

[sub_resource type="Resource" id="Resource_i2hsa"]
script = ExtResource("5_5qo2o")
id = 10
_name = "Bestiary Progression"
short_description = "Improves knowledge of creatures."
long_description = "Bestiary Progression tracks knowledge and understanding of creatures, improving effectiveness when dealing with known enemy types."

[sub_resource type="Resource" id="Resource_ywnu7"]
script = ExtResource("4_diqh5")
modifier_1 = SubResource("Resource_1e8n2")
modifier_1_expression = "x + 2"
modifier_2 = SubResource("Resource_i2hsa")
modifier_2_expression = "x * 3"
min_value = 1
max_value = 10
id = 5
_name = "Intelligence"
short_description = "Represents reasoning and analytical ability."
long_description = "Intelligence governs a character’s capacity for logic, learning, and understanding complex systems. It enhances awareness of enemies and the environment, improving bestiary knowledge and analysis. High Intelligence also refines control over magical and tactical effects, increasing the duration of buffs and debuffs applied in combat."

[sub_resource type="Resource" id="Resource_rty05"]
script = ExtResource("5_5qo2o")
id = 11
_name = "Mana Generation"
short_description = "Increases mana gained over time."
long_description = "Mana Generation determines how quickly a character regains magical energy over time, supporting sustained spellcasting."

[sub_resource type="Resource" id="Resource_l652r"]
script = ExtResource("5_5qo2o")
id = 12
_name = "Concentration"
short_description = "Determines sustained mental focus."
long_description = "Concentration governs the ability to maintain focus on ongoing effects, spells, or abilities without interruption."

[sub_resource type="Resource" id="Resource_jm731"]
script = ExtResource("4_diqh5")
modifier_1 = SubResource("Resource_rty05")
modifier_1_expression = "floor(x / 2)"
modifier_2 = SubResource("Resource_l652r")
modifier_2_expression = "ceil(x / 2.0)"
min_value = 1
max_value = 10
id = 6
_name = "Resolve"
short_description = "Represents mental fortitude and determination."
long_description = "Resolve reflects a character’s strength of will, focus, and emotional stability under pressure. It determines how well a character maintains concentration during combat and how resistant they are to negative mental or magical effects. Characters with high Resolve can shrug off debilitating conditions and remain steadfast in challenging situations."

[sub_resource type="Resource" id="Resource_p45st"]
script = ExtResource("7_5pqe7")
category = "Background"
