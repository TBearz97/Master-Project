id = 7
_name = "Calatherian Principality"
short_description = "Seafaring realm where trade, exploration, and danger intertwine."
long_description = "You come from a coastal principality defined by its connection to the sea. Commerce, exploration, and a touch of lawlessness shape daily life, and the ocean is both opportunity and threat."

[sub_resource type="Resource" id="Resource_e7k0j"]
