long_description = "Your kind-hearted and altruistic nature inspires and empowers your companions. When you assist another character, add your full relevant skill instead of half."

[sub_resource type="Resource" id="Resource_uhbrm"]
script = ExtResource("7_5pqe7")
category = "Race"
requirement_text = "Goliath only"
id = 2
_name = "Unyielding"
short_description = "When you suffer Trauma, you do not suffer the extra Concentration loss from it."
long_description = "Your people are shaped by hardship and do not break easily. When you suffer Trauma, you do not suffer the extra Concentration loss from it."

[sub_resource type="Resource" id="Resource_r2vid"]
script = ExtResource("7_5pqe7")
category = "Race"
requirement_text = "High Elf only"
id = 3
_name = "Social Beings"
short_description = "You gain +2 Renown, representing your higher standing within societies."
long_description = "High Elves naturally carry status and legitimacy in the eyes of many cultures. You gain +2 Renown, representing your higher standing within societies. Individual people may still feel however they wish about you."

[sub_resource type="Resource" id="Resource_qkt6c"]
script = ExtResource("7_5pqe7")
category = "Race"
requirement_text = "Dwarf only"
id = 4
_name = "Runic Destiny"
short_description = "Choose a rune that grants a distinct benefit tied to fortune, magic, or craftsmanship."
long_description = "From the moment of birth, every Dwarf bears a rune etched into their body, signifying clan, heritage, and fate. Choose one of the following runes:

Explorer's Rune - Whenever you roll on a loot table, roll twice and choose the outcome.

Magister's Rune - You know one spell for free.

Artisan's Rune - You gain +2 on tests when using something you made yourself."

[sub_resource type="Resource" id="Resource_vapoo"]
script = ExtResource("7_5pqe7")
category = "Race"
requirement_text = "Halfling only"
id = 5
_name = "Nimble Escape"
short_description = "When moving out of melee with only one opponent threatening you, the extra AP cost does not apply."
long_description = "Your small frame and quick instincts make it difficult to pin you down. When moving out of melee with only one opponent threatening you, the extra AP cost does not apply."

[sub_resource type="Resource" id="Resource_ckgvd"]
script = ExtResource("7_5pqe7")
category = "Race"
requirement_text = "Ashborne only"
id = 6
_name = "From Fire and Flame"
short_description = "A random body location gains an obsidian patch that is immune to damage until the patch is broken."
long_description = "Forged in the heart of a volcano, your body grows magical obsidian patches. Roll a random location at character creation. That location is immune to damage while the obsidian patch remains. If that location suffers 2 Trauma, the patch is destroyed. It regrows after a week, when your Vitality is reset."

[sub_resource type="Resource" id="Resource_x4hts"]
script = ExtResource("7_5pqe7")
category = "Race"
requirement_text = "Wood Elf only"
id = 7
_name = "Forest Child"
short_description = "You cannot safely eat meat, are immune to disease, and all other food gives you double benefit."
long_description = "Living in harmony with nature, your diet is strictly herbivorous. You cannot safely eat meat; if you do, your Max Health is reduced by 25% until you have had a full night's rest. You are immune to disease, and all other food gives you double benefit."

[sub_resource type="Resource" id="Resource_4ra5h"]
script = ExtResource("7_5pqe7")
category = "Race"
requirement_text = "Orc only"
id = 8
_name = "We Endure"
short_description = "During each full rest, heal one additional Injury or reduce one disease duration by an additional step."
long_description = "Life is harsh, and your people are shaped by enduring it. During each full rest, you may either heal one additional Injury or reduce the duration of one disease by an additional step."

[sub_resource type="Resource" id="Resource_pfcfl"]
script = ExtResource("7_5pqe7")
category = "Race"
requirement_text = "Husk-Folk only"
id = 9
_name = "Soulless"
short_description = "You are immune to necrotic damage and instead heal the full amount it would have dealt."
long_description = "Though still fully living people, Husk-Folk have been touched by necrosis so deeply that it no longer harms them as it does others. You are immune to necrotic damage. Instead, you heal the full amount of necrotic damage that would have been inflicted upon you."

[sub_resource type="Resource" id="Resource_wehdd"]
script = ExtResource("7_5pqe7")
category = "Weapon"
requirement_text = "Requirement: Level 2"
id = 40
_name = "Weapon Proficiency"
short_description = "Unlock Proficiency attacks for one weapon type."
long_description = "Choose one weapon type. You gain access to that weapon's Proficiency attacks."

[sub_resource type="Resource" id="Resource_87oym"]
script = ExtResource("7_5pqe7")
category = "Weapon"
requirement_text = "Requirement: Weapon Proficiency with the chosen weapon, Level 10"
id = 41
_name = "Weapon Expertise"
short_description = "Unlock Expertise attacks for one weapon type."
long_description = "Choose one weapon type in which you already have Weapon Proficiency. You gain access to that weapon's Expertise attacks."

[sub_resource type="Resource" id="Resource_mvhqj"]
script = ExtResource("7_5pqe7")
category = "Weapon"
id = 42
_name = "Weapon Mastery"
short_description = "Increase proficiency with chosen weapon type."
long_description = "Gain improved control and critical chance with a selected weapon class."

[sub_resource type="Resource" id="Resource_6sk1b"]
script = ExtResource("7_5pqe7")
category = "Weapon"
requirement_text = "Requirement: Weapon Proficiency, Dexterity 6"
id = 43
_name = "Quick Swap"
short_description = "Swap weapons or loadouts more quickly."
long_description = "Once per round, you may swap loadouts or ready a different weapon as a free action."

[sub_resource type="Resource" id="Resource_pm88h"]
script = ExtResource("7_5pqe7")
category = "Weapon"
requirement_text = "Requirement: Quick Swap, Level 4"
id = 44
_name = "Master at Arms"
short_description = "Gain an additional weapon loadout."
long_description = "You gain one additional weapon loadout."

[sub_resource type="Resource" id="Resource_4rtfr"]
