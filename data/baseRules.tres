requirement_text = "Requirement: Dexterity 7, Weapon Proficiency with a one-handed melee weapon"
id = 46
_name = "Duelist"
short_description = "Gain Deflection while dueling one-handed."
long_description = "While wielding a single one-handed melee weapon and no shield, gain +1 Deflection."

[sub_resource type="Resource" id="Resource_qbhhr"]
script = ExtResource("7_5pqe7")
category = "Weapon"
requirement_text = "Requirement: Duelist, Level 5"
id = 47
_name = "Riposte"
short_description = "Counter missed melee attacks more effectively."
long_description = "The first time each round a creature misses you with a melee attack, your next melee attack against that creature gains +1 Accuracy and deals 10% more damage."

[sub_resource type="Resource" id="Resource_83kd0"]
script = ExtResource("7_5pqe7")
category = "Weapon"
requirement_text = "Requirement: Perception 6"
id = 48
_name = "Accurate"
short_description = "Re-roll one attack each round with a proficient weapon."
long_description = "Once each round, you may re-roll 1d20 on an attack made with a weapon you have proficiency in."

[sub_resource type="Resource" id="Resource_ebhi1"]
script = ExtResource("7_5pqe7")
category = "Weapon"
requirement_text = "Requirement: Accurate, Level 4"
id = 49
_name = "Center of Mass"
short_description = "Gain Accuracy at normal ranged distance."
long_description = "When you make a ranged attack against a creature within the weapon's normal range, gain +1 Accuracy."

[sub_resource type="Resource" id="Resource_m7e5y"]
script = ExtResource("7_5pqe7")
category = "Weapon"
requirement_text = "Requirement: Center of Mass, Level 7"
id = 50
_name = "Bull's Eye"
short_description = "Your first ranged attack each round gains a better crit die."
long_description = "The first ranged attack you make each round gains +1 Crit Die size."

[sub_resource type="Resource" id="Resource_wvmao"]
script = ExtResource("7_5pqe7")
category = "Weapon"
requirement_text = "Requirement: Might 7"
id = 51
_name = "Giant's Grip"
short_description = "Handle large weapons more easily."
long_description = "You can wield a two-handed melee weapon in one hand for the purpose of carrying or readying it, but you still need two hands to use its attacks unless another rule says otherwise."

[sub_resource type="Resource" id="Resource_7xvql"]
script = ExtResource("7_5pqe7")
category = "Weapon"
requirement_text = "Requirement: Might 6, Constitution 6"
id = 52
_name = "Hold the Line"
short_description = "Make it harder for enemies to leave your Reach."
long_description = "Creatures provoke 1 additional AP to move out of your Reach."

[sub_resource type="Resource" id="Resource_yrod8"]
script = ExtResource("7_5pqe7")
category = "Weapon"
requirement_text = "Requirement: Might 7, Constitution 6, Level 5"
id = 53
_name = "Heavy Armor Master"
short_description = "Gain extra Physical DT in Heavy Load."
long_description = "While in Heavy Load, gain +1 Physical DT."

[sub_resource type="Resource" id="Resource_dd1ts"]
script = ExtResource("7_5pqe7")
category = "Weapon"
requirement_text = "Requirement: Resolve 6, Level 5"
id = 54
_name = "Mage Slayer"
short_description = "Damage can reduce enemy Concentration."
long_description = "When you damage a creature that currently has Concentration, reduce its Concentration by 1. This can only happen once per turn."

[sub_resource type="Resource" id="Resource_ebkcq"]
script = ExtResource("7_5pqe7")
category = "Weapon"
requirement_text = "Requirement: Dexterity 6"
id = 55
_name = "Fast Hands"
short_description = "Reduce the AP cost of your first Interact each round."
long_description = "The first Interact action you take each round costs 1 less AP, to a minimum of 1."

[sub_resource type="Resource" id="Resource_o7st5"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Intelligence 6, Lore 2"
id = 56
_name = "Magical Student"
short_description = "Learn Theoretical spells from your spellbook."
long_description = "Learn Theoretical spells through study and observation, gaining permanent access to all spells recorded in your spellbook without needing preparation."

[sub_resource type="Resource" id="Resource_sks1i"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Resolve 6"
id = 57
_name = "Patronage"
short_description = "Gain magic through patrons and bargains."
long_description = "Gain spells from any school through deals, sacrifices, and narrative events, with your power shaped and potentially altered by your patron."

[sub_resource type="Resource" id="Resource_y1o4w"]
script = ExtResource("7_5pqe7")
category = "Magic"
id = 58
_name = "Conviction"
short_description = "Resist fear and charm."
long_description = "Unshakeable faith grants immunity to fear and control effects."

[sub_resource type="Resource" id="Resource_o03vu"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Resolve 6, Survival 2 or Lore 2"
id = 59
_name = "Ritualist"
short_description = "Prepare Primal spells through ritual."
long_description = "Select a limited number of Primal spells after performing a ritual, allowing you to change your available spells during a full rest."

[sub_resource type="Resource" id="Resource_1g6x7"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Resolve 6"
id = 60
_name = "Innate Power"
short_description = "Learn spells tied to a chosen magical keyword."
long_description = "Choose a magical keyword, such as Fire, Illusion, or Necrotic. You learn matching spells from any school, with a limited number of permanently known spells that grows as you level."

[sub_resource type="Resource" id="Resource_t720k"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Resolve 7"
id = 61
_name = "Font of Mana"
short_description = "Increase maximum Mana."
long_description = "Increase your maximum Mana by 2."

[sub_resource type="Resource" id="Resource_20ox3"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Any magical identity perk, Level 3"
id = 62
_name = "Quiet Casting"
short_description = "Casting is harder to notice."
long_description = "Tests made to notice your spellcasting become harder unless the spell is especially loud, bright, or destructive."

[sub_resource type="Resource" id="Resource_n773f"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Resolve 7, Level 4"
id = 63
_name = "Mind Fortress"
short_description = "Gain Concentration."
long_description = "Gain +1 Concentration."

[sub_resource type="Resource" id="Resource_fihkr"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Any magical identity perk, Weapon Proficiency, Level 4"
id = 64
_name = "Spellsword"
short_description = "Use a weapon as a casting focus and gain Mana on hit."
long_description = "Choose one weapon type you have Weapon Proficiency with. That weapon counts as a casting focus for you, and the first time each round you deal damage with it you gain 1 Mana."

[sub_resource type="Resource" id="Resource_r3iso"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Ability to deal Fire damage"
id = 65
_name = "Pyromaniac"
short_description = "Deal more damage to burning targets."
long_description = "You deal 10% more damage against targets that are on fire. If a single attack or spell affects more than one target that is on fire, increase the damage by an additional 10% for each extra burning target, up to 30% total."

[sub_resource type="Resource" id="Resource_p1n2g"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Ability to deal Fire damage"
id = 66
_name = "Fire Starter"
short_description = "Improve your first Fire effect each round."
long_description = "The first time each round you deal Fire damage, you may re-roll 1d20 on one Fire-related damage or effect roll tied to that action. If the table does not use such a roll, that attack or spell instead deals 10% more damage."

[sub_resource type="Resource" id="Resource_klcv5"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Ability to deal Freeze damage or use Ice magic"
id = 67
_name = "Cryo-Expert"
short_description = "Freeze effects also drain AP."
long_description = "Creatures affected by your Ice or Freeze effects are easier to keep controlled. The first time each round you inflict Freeze, the target also loses 1 AP."

[sub_resource type="Resource" id="Resource_8asyo"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Ability to deal Necrotic damage"
id = 68
_name = "Necrosis"
short_description = "Ignore some Necrotic DT."
long_description = "When you deal Necrotic damage, ignore 1 Necrotic DT."

[sub_resource type="Resource" id="Resource_6ukck"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Perception 6"
id = 69
_name = "Deliberate Strikes"
short_description = "Gain Mana on critical hits."
long_description = "Whenever one of your attacks scores a critical hit, gain 1 Mana."

[sub_resource type="Resource" id="Resource_ge1i1"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Deliberate Strikes, Perception 8, Level 8"
id = 70
_name = "Crits on Crits"
short_description = "Max crit dice can explode once."
long_description = "When one of your Crit Dice rolls its highest value, roll one additional Crit Die of the same size and add it. Dice generated by this perk cannot generate further Crit Dice."

[sub_resource type="Resource" id="Resource_u0l7g"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Might 6 or Resolve 6"
id = 71
_name = "Bloodlust"
short_description = "Gain Mana when dealing heavy damage."
long_description = "When you deal 5 or more HP damage with a single attack or spell, gain 1 Mana. If you deal 10 or more HP damage, gain 2 Mana instead. You cannot gain more than 2 Mana per turn from this perk."

[sub_resource type="Resource" id="Resource_52uai"]
script = ExtResource("7_5pqe7")
category = "Magic"
requirement_text = "Requirement: Resolve 6, Level 4"
id = 72
_name = "Hemomancy"
short_description = "Gain Mana when suffering heavy damage."
long_description = "When you suffer 5 or more HP damage from a single source, gain 1 Mana. If you suffer 10 or more HP damage, gain 2 Mana instead. You cannot gain more than 2 Mana per turn from this perk."

[sub_resource type="Resource" id="Resource_fyy8f"]
