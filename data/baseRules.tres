_name = "Momentum"
short_description = "Successive weapon hits sharpen your accuracy."
long_description = "Each consecutive successful weapon attack you make in a round grants +1 Accuracy to your next weapon attack that round, up to +3. This bonus resets when you miss or when the round ends."

[sub_resource type="Resource" id="Resource_6tvm9"]
