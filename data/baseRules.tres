long_description = "Effective against targets within 11 to 13 hexes, pushing the limits of range and precision."

[sub_resource type="Resource" id="Resource_a4te0"]
script = ExtResource("28_xvgww")
expression = "rollDice(1, 20) + skill >= difficulty"
id = 1
_name = "skill_check"
short_description = "Skill check succeeds if roll + skill >= Difficulty."
long_description = "Roll 1d20 and add the relevant skill. If the result meets or exceeds the Difficulty, the test succeeds."

[sub_resource type="Resource" id="Resource_1uivu"]
script = ExtResource("28_xvgww")
expression = "rollDice(1, 20) + actor_skill > rollDice(1, 20) + target_skill"
id = 2
_name = "opposed_check"
short_description = "Opposed roll comparison."
long_description = "Both sides roll 1d20 and add skill. Higher result wins."

[sub_resource type="Resource" id="Resource_f414b"]
script = ExtResource("28_xvgww")
expression = "rollDice(1, 20) + accuracy >= defense"
id = 3
_name = "attack_hit"
short_description = "Attack hits if roll + accuracy >= defense."
long_description = "Roll 1d20 and add Accuracy. If the result meets or exceeds the target defense, the attack hits."

[sub_resource type="Resource" id="Resource_l63e7"]
script = ExtResource("28_xvgww")
expression = "damage * 0.5"
id = 4
_name = "damage_with_resistance"
short_description = "Apply resistance."
long_description = "Resistance halves damage after threshold."

[sub_resource type="Resource" id="Resource_hcogc"]
script = ExtResource("28_xvgww")
expression = "damage * 2"
id = 5
_name = "damage_with_vulnerability"
short_description = "Apply vulnerability."
long_description = "Vulnerability doubles damage after threshold."

[sub_resource type="Resource" id="Resource_d7mwu"]
script = ExtResource("28_xvgww")
expression = "damage_roll == damage_die_max"
id = 6
_name = "crit_trigger"
short_description = "Critical triggers on max roll."
long_description = "Critical occurs when damage roll equals die maximum."

[sub_resource type="Resource" id="Resource_ay5j0"]
script = ExtResource("28_xvgww")
expression = "damage >= trauma_threshold"
id = 7
_name = "trauma_trigger"
short_description = "Trauma occurs when damage exceeds threshold."
long_description = "If damage to a location exceeds trauma threshold, Trauma occurs."

[sub_resource type="Resource" id="Resource_xgbk8"]
script = ExtResource("28_xvgww")
expression = "(level * (level - 1) / 2) * 100"
id = 8
_name = "xp_required"
short_description = "XP formula"
long_description = "XP required for level follows a quadratic formula."

[sub_resource type="Resource" id="Resource_56rwn"]
script = ExtResource("28_xvgww")
expression = "6"
id = 9
_name = "level_skill_points_gain"
short_description = "Skill points gained on level up."
long_description = "Each level grants 6 skill points."

[sub_resource type="Resource" id="Resource_37q0m"]
script = ExtResource("28_xvgww")
expression = "1"
id = 10
_name = "level_perk_gain"
short_description = "Perk gained on level up."
long_description = "Each level grants 1 perk."

[sub_resource type="Resource" id="Resource_pqppm"]
script = ExtResource("28_xvgww")
expression = "12"
id = 11
_name = "skill_points_character_creation"
short_description = "Starting skill points."
long_description = "At character creation, the player has 12 skill points to distribute."

[sub_resource type="Resource" id="Resource_5cuy2"]
