expression = "5"
id = 14
_name = "attribute_base_value"
short_description = "Base attribute value."
long_description = "All attributes start at 5 during character creation."

[sub_resource type="Resource" id="Resource_ciyte"]
script = ExtResource("28_xvgww")
expression = "5"
id = 15
_name = "attribute_creation_points"
short_description = "Attribute points available."
long_description = "Player has 5 points to distribute during character creation."

[sub_resource type="Resource" id="Resource_mb025"]
script = ExtResource("28_xvgww")
expression = "1"
id = 16
_name = "attribute_increase_cost"
short_description = "Cost to increase attribute."
long_description = "Increasing an attribute by 1 costs 1 point."

[sub_resource type="Resource" id="Resource_w8mtr"]
