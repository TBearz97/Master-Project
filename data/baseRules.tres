category = "Homeland"
requirement_text = "Asharati Forest only"
id = 17
_name = "Animal Friend"
short_description = "Beasts will not attack you on sight; gain a reroll on Animal Handling."
long_description = "When you encounter a creature with the Beast tag, it will never attack you on sight. Also gain 1 reroll on all Animal Handling tests."

[sub_resource type="Resource" id="Resource_d8kd5"]
