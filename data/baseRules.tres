long_description = "Perception measures a character’s ability to notice details, aim accurately, and react swiftly to subtle changes in their surroundings. High Perception increases accuracy with all attacks and improves the likelihood of striking vital points, resulting in more devastating critical hits."

[sub_resource type="Resource" id="Resource_efdn6"]
script = ExtResource("1_j010n")
value = 1
bonus_1_prefix = "Bestiary Progress:"
bonus_2_prefix = "Buff/Debuff Duration:"
bonus_1_expression = "(x * 3)"
bonus_2_expression = "(x * 5)"
bonus_1_suffix = "%"
_name = "Intelligence"
short_description = "Represents reasoning and analytical ability."
long_description = "Intelligence governs a character’s capacity for logic, learning, and understanding complex systems. It enhances awareness of enemies and the environment, improving bestiary knowledge and analysis. High Intelligence also refines control over magical and tactical effects, increasing the duration of buffs and debuffs applied in combat."

[sub_resource type="Resource" id="Resource_247ah"]
script = ExtResource("1_j010n")
value = 1
bonus_1_prefix = "Concentration:"
bonus_2_prefix = "Debuff Resistance:"
bonus_1_expression = "x"
bonus_2_expression = "x * 5"
_name = "Resolve"
short_description = "Represents mental fortitude and determination."
long_description = "Resolve reflects a character’s strength of will, focus, and emotional stability under pressure. It determines how well a character maintains concentration during combat and how resistant they are to negative mental or magical effects. Characters with high Resolve can shrug off debilitating conditions and remain steadfast in challenging situations."

