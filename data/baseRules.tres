[sub_resource type="Resource" id="Resource_fumye"]
script = ExtResource("227_g4678")
data = SubResource("Resource_0456o")
_name = "Ghoul"
short_description = "A feral flesh-hungry undead."
long_description = "A swift and ravenous undead horror that attacks in frenzied bursts and drags foes down."

[sub_resource type="Resource" id="Resource_h7bi3"]
script = ExtResource("3_vnboh")
category = "Race"
_name = "Good Natured"
short_description = "Share your full expertise when aiding allies, gaining the same rewards."
long_description = "Your kind-hearted and altruistic nature inspires and empowers your companions, allowing you to lend your full expertise to support them in their endeavors. When aiding another character you add your entire skill bonus rather than half. Any IP generated from that test you also gain."

[sub_resource type="Resource" id="Resource_b58qr"]
script = ExtResource("3_vnboh")
category = "Race"
_name = "Survival of the Fittest"
short_description = "Strong and enduring, but limited agility and charm."
long_description = "Hardened by the trials of a ruthless environment, your physical prowess has been honed to perfection, though at the expense of social grace and nimbleness. Strength and Endurance increases by 2 and their max is now 12. However Agility and Charisma can't be higher than 6."

[sub_resource type="Resource" id="Resource_labk4"]
script = ExtResource("3_vnboh")
category = "Race"
_name = "Social Beings"
short_description = "Naturally persuasive, gaining a boost in conversations."
long_description = "With an innate charm and eloquence, High Elves effortlessly navigate social landscapes, bending conversations to their will with ease and finesse. High Elves have a knack for getting what they want in conversations, gain a +2 Social Modifier."

[sub_resource type="Resource" id="Resource_6tdnd"]
script = ExtResource("3_vnboh")
category = "Race"
_name = "Runic Destiny"
short_description = "Each rune grants unique powers of luck, magic, or craft."
long_description = "From the moment of birth, every Dwarf bears a unique rune etched into their body, signifying their clan and heritage. These mystical runes are not just marks of identity; they bestow powerful benefits that shape the destiny of each Dwarf.\\n\\nExplorer's Rune\\nMarked by the Explorer's Rune, your fate is intertwined with fortune and discovery. The rune guides your hand, ensuring you find the best rewards on your journeys. Every time you roll on a loot table, roll twice and choose the outcome.\\n\\nMagister's Rune\\nThe Magister's Rune bestows upon you an innate mastery of mystical arts. This rune amplifies your connection to the magical realms, enhancing your spellcasting and mystical insights. You gain an extra Tag in either Arcana, Shamanism or Zeal.\\n\\nArtisan's Rune\\nBearing the Artisan's Rune, your hands are gifted with extraordinary skill. This rune enhances your craftsmanship, making anything you create a testament to your exceptional talent. You gain Tag in Craft and a +2 for any skill test where you are using something you made your self."

[sub_resource type="Resource" id="Resource_f3jx2"]
script = ExtResource("3_vnboh")
category = "Race"
_name = "Small Frame"
short_description = "Agile and charming, but physically weaker."
long_description = "Your slight build grants you unparalleled agility and an appealing presence, yet it limits your physical strength and stamina. Agility and Charisma increases by 2 and their max is now 12. However Strength and Endurance can't be higher than 6."

[sub_resource type="Resource" id="Resource_owwpf"]
script = ExtResource("3_vnboh")
category = "Race"
_name = "From Fire and Flame"
short_description = "Obsidian patches grant immunity to damage in one chosen spot."
long_description = "Forged in the heart of a volcano, your body is adorned with obsidian patches that render you impervious to harm, a testament to your fiery origin. Your body grows magical Obsidian patches around your body, choose one location where they have converged making you entirely immune to damage."

[sub_resource type="Resource" id="Resource_ipy2j"]
script = ExtResource("3_vnboh")
category = "Race"
_name = "Forest Child"
short_description = "Plant-based diet grants immunity to disease and better nourishment."
long_description = "Living in harmony with nature, your diet is strictly herbivorous. This bond with the forest grants you immunity to disease and enhanced nourishment from plant-based foods. You can't eat meat, if you do you Max Health is reduced by 25% until a you've had a full nights rest. You are also immune to diseases and all other food gives you double benefit."

[sub_resource type="Resource" id="Resource_akr0u"]
script = ExtResource("3_vnboh")
category = "Race"
_name = "Resilient Frame"
short_description = "Sturdy bones give you an edge against injuries."
long_description = "Your bones are exceptionally sturdy, providing a robust defense against injuries that would cripple others. When making a Fortitude test to resist injury, gain +5 for that test."

[sub_resource type="Resource" id="Resource_8cgvh"]
script = ExtResource("3_vnboh")
category = "Race"
_name = "Soulless"
short_description = "Necrotic damage heals you instead of harming you."
long_description = "Devoid of a soul, the forces of necrosis that would harm others instead rejuvenate you, turning death itself into a source of strength. You are immune to necrotic damage. In fact, you’re healed by it, you regain half of the necrotic damage inflicted upon you."

