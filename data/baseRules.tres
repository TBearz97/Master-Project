expression = "current_equip_load > (max_equip_load * 2 / 3) and current_equip_load <= max_equip_load"
id = 22
_name = "equip_load_heavy"
short_description = "Heavy load threshold."
long_description = "Heavy load is above two thirds and up to maximum equip load."

[sub_resource type="Resource" id="Resource_774av"]
