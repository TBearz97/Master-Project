_name = "Asharati Forest"
short_description = "Ancient forest where nature and its creatures are deeply respected."
long_description = "You were raised within vast, living forests where harmony with nature is central to survival. The bond between people and the natural world is strong, shaping a culture of respect and balance."

[sub_resource type="Resource" id="Resource_qiaj5"]
