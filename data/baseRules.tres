_name = "Cartographer"
long_description = "Requirement: Navigation 2\\\\n\\\\nWhen mapping a route, charting an area, or returning by a known path, re-roll 1d20 on the test."

[sub_resource type="Resource" id="Resource_tg4wd"]
script = ExtResource("4_wtekf")
category = "Knowledge and Craft"
_name = "Seafarer"
long_description = "Requirement: Navigation 2\\\\n\\\\nNavigation tests at sea become easier."

[sub_resource type="Resource" id="Resource_kl4hb"]
