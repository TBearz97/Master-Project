category = "Knowledge and Craft"
_name = "Historian"
long_description = "Requirement: Lore 2\\\\n\\\\nTests involving major historical events, dynasties, ruins, and old conflicts become easier."

[sub_resource type="Resource" id="Resource_4rtfr"]
