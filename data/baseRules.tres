max_distance = 7
short_hand = "M"
id = 3
_name = "Medium"
short_description = "Moderate ranged distance."
long_description = "Effective against targets within 5 to 7 hexes, representing standard ranged engagement distance."

[sub_resource type="Resource" id="Resource_m3n1k"]
