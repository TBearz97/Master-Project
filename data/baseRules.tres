short_description = "Gain respect in formal settings."
long_description = "Your upbringing in a refined kingdom grants you the manners and expectations of civilized life. In formal settings, you are treated with the respect due to proper station unless you give others reason not to."

[sub_resource type="Resource" id="Resource_48xaf"]
script = ExtResource("16_52rkp")
perk = SubResource("Resource_ykot2")
id = 2
_name = "The Orotari Kingdom"
short_description = "Refined kingdom known for culture, learning, and structure."
long_description = "You come from a prosperous and orderly realm where education, discipline, and tradition are highly valued. Society here emphasizes knowledge, refinement, and a clear social hierarchy."

[sub_resource type="Resource" id="Resource_i7mxn"]
script = ExtResource("7_5pqe7")
category = "Homeland"
requirement_text = "Frostheim Kingdom only"
id = 12
_name = "Frostborn"
short_description = "Increase Survival rating against cold exposure."
long_description = "You can increase your Survival rating by 1.5 when it comes to exposure to cold weather."

[sub_resource type="Resource" id="Resource_mv2df"]
script = ExtResource("16_52rkp")
perk = SubResource("Resource_i7mxn")
id = 3
_name = "The Frostheim Kingdom"
short_description = "Frozen realm where endurance and resilience define daily life."
long_description = "You were raised in a land of relentless cold, where survival depends on endurance and preparation. The harsh environment has instilled in you a quiet toughness and respect for nature’s unforgiving conditions."

[sub_resource type="Resource" id="Resource_yqrhg"]
script = ExtResource("7_5pqe7")
category = "Homeland"
requirement_text = "Quasarian Empire only"
id = 13
_name = "Desert Adventurer"
short_description = "Increase Survival rating against heat and endure thirst longer."
long_description = "You can increase your Survival rating by 1.5 when it comes to exposure to hot weather. You can go an hour longer for every stage of Thirst and hot weather does not halve it."

[sub_resource type="Resource" id="Resource_pkvjd"]
script = ExtResource("16_52rkp")
perk = SubResource("Resource_yqrhg")
id = 4
_name = "The Quasarian Empire"
short_description = "Vast desert empire shaped by heat, scarcity, and strength."
long_description = "You hail from a powerful empire built within unforgiving deserts. Life revolves around managing scarce resources, enduring extreme conditions, and navigating a culture forged by hardship and ambition."

[sub_resource type="Resource" id="Resource_osvgl"]
script = ExtResource("7_5pqe7")
category = "Homeland"
requirement_text = "Untamed Highlands only"
id = 14
_name = "No Safe Roads"
short_description = "Experience favors you in dangerous travel."
long_description = "Travel-related rules will favor your experience once those systems are in place."

[sub_resource type="Resource" id="Resource_cul7c"]
script = ExtResource("16_52rkp")
perk = SubResource("Resource_osvgl")
id = 5
_name = "The Untamed Highlands"
short_description = "Diverse highlands of scattered cities and shifting cultures."
long_description = "You grew up among a wide range of independent cities, each with its own customs and expectations. This environment required adaptability, awareness, and an ability to navigate varied social landscapes."

[sub_resource type="Resource" id="Resource_i0u8y"]
script = ExtResource("7_5pqe7")
category = "Homeland"
requirement_text = "Torgana Canyons only"
id = 15
_name = "Born to Fight"
short_description = "Once per scene, ignore one attack that targets you."
long_description = "Once per scene, you can completely ignore one attack that targets you."

[sub_resource type="Resource" id="Resource_ls3te"]
script = ExtResource("16_52rkp")
perk = SubResource("Resource_i0u8y")
id = 6
_name = "Torgana Canyons"
short_description = "Rugged canyonlands where strength and resilience are essential."
long_description = "You were raised in a harsh terrain of deep canyons and unforgiving landscapes. Survival here demands physical strength, determination, and the ability to endure constant adversity."

[sub_resource type="Resource" id="Resource_56qn4"]
