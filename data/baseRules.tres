modifier_2 = SubResource("Resource_me7p3")
modifier_2_expression = "x"
min_value = 1
max_value = 10
id = 2
_name = "Dexterity"
short_description = "Represents speed, coordination, and reflexes."
long_description = "Dexterity reflects a character’s agility and precision in both physical and mental actions. It governs how quickly and efficiently a character can move, attack, and react. High Dexterity grants additional action points, allowing more actions per turn, and improves deflection, helping to avoid incoming attacks."

[sub_resource type="Resource" id="Resource_ngyn5"]
script = ExtResource("5_5qo2o")
id = 5
_name = "Health"
short_description = "Determines total health pool."
long_description = "Health represents the total amount of damage a character can sustain before being incapacitated. Increasing Health improves survivability."

[sub_resource type="Resource" id="Resource_7qc4m"]
script = ExtResource("5_5qo2o")
id = 6
_name = "Vitality"
short_description = "Represents endurance and recovery."
long_description = "Vitality reflects overall stamina and recovery capability, influencing how well a character endures prolonged activity and recovers from strain."

[sub_resource type="Resource" id="Resource_wol58"]
script = ExtResource("4_diqh5")
value = 3
modifier_1 = SubResource("Resource_ngyn5")
