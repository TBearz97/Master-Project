[ext_resource type="Script" path="res://content/codex/character_options/perk.gd" id="1_7lxc5"]

[resource]
script = ExtResource("1_7lxc5")
category = "Background"
_name = "Trained to Kill"
short_description = "Dragons are your sworn enemy."
long_description = "Reduce the Difficulty of Survival tests when tracking Dragons by 1. Re-roll 1d20 on every damaging attack against a Dragon. After killing a Dragon local villages will celebrate you as a hero, this means you sleep, drink and eat for free for the next 3 days."
