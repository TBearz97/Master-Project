[resource]
script = ExtResource("1_os3i3")
category = "Magic"
_name = "Spellsword"
long_description = "Requirement: Any magical identity perk, Weapon Proficiency, Level 4\\\\n\\\\nChoose one weapon type you have Weapon Proficiency with. That weapon counts as a casting focus for you, and the first time each round you deal damage with it you gain 1 Mana."
