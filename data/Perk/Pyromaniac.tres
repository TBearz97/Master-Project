script = ExtResource("1_i0alu")
category = "Magic"
_name = "Pyromaniac"
long_description = "Requirement: Ability to deal Fire damage\\\\n\\\\nYou deal 10% more damage against targets that are on fire. If a single attack or spell affects more than one target that is on fire, increase the damage by an additional 10% for each extra burning target, up to 30% total."
