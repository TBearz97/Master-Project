[ext_resource type="Script" path="res://content/codex/character_options/perk.gd" id="1_d202c"]

[resource]
script = ExtResource("1_d202c")
category = "Race"
_name = "Survival of the Fittest"
short_description = "Strong and enduring, but limited agility and charm."
long_description = "Hardened by the trials of a ruthless environment, your physical prowess has been honed to perfection, though at the expense of social grace and nimbleness. Strength and Endurance increases by 2 and their max is now 12. However Agility and Charisma can't be higher than 6."
