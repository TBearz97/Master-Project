script = ExtResource("1_w0ikc")
category = "Magic"
_name = "Innate Power"
long_description = "Requirement: Resolve 6\\\\n\\\\nChoose a magical keyword, such as Fire, Illusion, or Necrotic. You learn matching spells from any school, with a limited number of permanently known spells that grows as you level."
