script = ExtResource("1_513a3")
category = "Magic"
_name = "Hemomancy"
long_description = "Requirement: Resolve 6, Level 4\\\\n\\\\nWhen you suffer 5 or more HP damage from a single source, gain 1 Mana. If you suffer 10 or more HP damage, gain 2 Mana instead. You cannot gain more than 2 Mana per turn from this perk."
