[ext_resource type="Script" path="res://content/codex/character_options/perk.gd" id="1_sx1pd"]

[resource]
script = ExtResource("1_sx1pd")
category = "Race"
_name = "Good Natured"
short_description = "Support another player's skill check with practiced cooperation."
long_description = "Before another player makes a non-contested skill check, you may assist them. That check gains a bonus equal to half your value in the same skill, rounded down. Only one Good Natured assist can apply to a check."
