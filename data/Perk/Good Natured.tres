[ext_resource type="Script" path="res://content/codex/character_options/perk.gd" id="1_sx1pd"]

[resource]
script = ExtResource("1_sx1pd")
category = "Race"
_name = "Good Natured"
short_description = "Share your full expertise when aiding allies, gaining the same rewards."
long_description = "Your kind-hearted and altruistic nature inspires and empowers your companions, allowing you to lend your full expertise to support them in their endeavors. When aiding another character you add your entire skill bonus rather than half. Any IP generated from that test you also gain."
