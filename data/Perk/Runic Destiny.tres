[ext_resource type="Script" path="res://content/codex/character_options/perk.gd" id="1_pfvnr"]

[resource]
script = ExtResource("1_pfvnr")
category = "Race"
_name = "Runic Destiny"
short_description = "Each rune grants unique powers of luck, magic, or craft."
long_description = "From the moment of birth, every Dwarf bears a unique rune etched into their body, signifying their clan and heritage. These mystical runes are not just marks of identity; they bestow powerful benefits that shape the destiny of each Dwarf.\\n\\nExplorer's Rune\\nMarked by the Explorer's Rune, your fate is intertwined with fortune and discovery. The rune guides your hand, ensuring you find the best rewards on your journeys. Every time you roll on a loot table, roll twice and choose the outcome.\\n\\nMagister's Rune\\nThe Magister's Rune bestows upon you an innate mastery of mystical arts. This rune amplifies your connection to the magical realms, enhancing your spellcasting and mystical insights. You gain an extra Tag in either Arcana, Shamanism or Zeal.\\n\\nArtisan's Rune\\nBearing the Artisan's Rune, your hands are gifted with extraordinary skill. This rune enhances your craftsmanship, making anything you create a testament to your exceptional talent. You gain Tag in Craft and a +2 for any skill test where you are using something you made your self."
