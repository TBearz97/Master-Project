[ext_resource type="Script" path="res://content/codex/character_options/perk.gd" id="1_yl5y3"]

[resource]
script = ExtResource("1_yl5y3")
category = "Magic"
_name = "Crits on Crits"
long_description = "Requirement: Deliberate Strikes, Perception 8, Level 8\\\\n\\\\nWhen one of your Crit Dice rolls its highest value, roll one additional Crit Die of the same size and add it. Dice generated by this perk cannot generate further Crit Dice."
