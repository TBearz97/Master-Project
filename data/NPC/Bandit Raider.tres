[sub_resource type="Resource" id="Resource_167fk"]
script = ExtResource("2_d3qty")
value = 1
bonus_1_prefix = "Damage & Healing:"
bonus_2_prefix = "Carry Weight:"
bonus_1_expression = "(x - 1) * 5"
bonus_2_expression = "((x - 1) * 5) + 75"
bonus_1_suffix = "%"
bonus_2_suffix = "kg"
_name = "Might"
short_description = "Represents physical and spiritual strength."
long_description = "Might measures the character’s raw physical and inner power. It influences both physical and magical damage as well as the effectiveness of healing abilities. Characters with higher Might deal and heal more damage and can carry heavier loads."

[sub_resource type="Resource" id="Resource_4csf1"]
script = ExtResource("2_d3qty")
value = 1
bonus_1_prefix = "Action Points:"
bonus_2_prefix = "Deflection:"
bonus_1_expression = "x + 3"
bonus_2_expression = "x"
_name = "Dexterity"
short_description = "Represents speed, coordination, and reflexes."
long_description = "Dexterity reflects a character’s agility and precision in both physical and mental actions. It governs how quickly and efficiently a character can move, attack, and react. High Dexterity grants additional action points, allowing more actions per turn, and improves deflection, helping to avoid incoming attacks."

[sub_resource type="Resource" id="Resource_uhbx4"]
script = ExtResource("2_d3qty")
value = 1
bonus_1_prefix = "Health:"
bonus_2_prefix = "Vitality:"
bonus_1_expression = "x + 5"
bonus_2_expression = "(3 + floor((x - 1) / 3))"
bonus_1_suffix = "x Level"
bonus_2_suffix = "x Health"
_name = "Constitution"
short_description = "Represents endurance and overall toughness."
long_description = "Constitution determines a character’s physical resilience and ability to withstand harm, fatigue, and disease. It directly affects maximum health and long-term vitality, influencing how long a character can endure in battle or harsh environments. Those with higher Constitution can take more punishment and recover faster from strain."

[sub_resource type="Resource" id="Resource_phlid"]
script = ExtResource("2_d3qty")
value = 1
bonus_1_prefix = "Accuracy:"
bonus_2_prefix = "Critical Damage:"
bonus_1_expression = "x"
bonus_2_expression = "((x - 1) * 5) + 50"
bonus_2_suffix = "%"
_name = "Perception"
short_description = "Represents awareness and precision."
long_description = "Perception measures a character’s ability to notice details, aim accurately, and react swiftly to subtle changes in their surroundings. High Perception increases accuracy with all attacks and improves the likelihood of striking vital points, resulting in more devastating critical hits."

[sub_resource type="Resource" id="Resource_ujyo7"]
script = ExtResource("2_d3qty")
value = 1
bonus_1_prefix = "Bestiary Progress:"
bonus_2_prefix = "Buff/Debuff Duration:"
bonus_1_expression = "(x * 3)"
bonus_2_expression = "(x * 5)"
bonus_1_suffix = "%"
_name = "Intelligence"
short_description = "Represents reasoning and analytical ability."
long_description = "Intelligence governs a character’s capacity for logic, learning, and understanding complex systems. It enhances awareness of enemies and the environment, improving bestiary knowledge and analysis. High Intelligence also refines control over magical and tactical effects, increasing the duration of buffs and debuffs applied in combat."

[sub_resource type="Resource" id="Resource_avgch"]
script = ExtResource("2_d3qty")
value = 1
bonus_1_prefix = "Concentration:"
bonus_2_prefix = "Debuff Resistance:"
bonus_1_expression = "x"
bonus_2_expression = "x * 5"
_name = "Resolve"
short_description = "Represents mental fortitude and determination."
long_description = "Resolve reflects a character’s strength of will, focus, and emotional stability under pressure. It determines how well a character maintains concentration during combat and how resistant they are to negative mental or magical effects. Characters with high Resolve can shrug off debilitating conditions and remain steadfast in challenging situations."

