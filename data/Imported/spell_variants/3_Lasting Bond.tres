[sub_resource type="Resource" id="Resource_8ajbq"]
script = ExtResource("3_2x64w")
school = SubResource("Resource_ww6q2")
tags = Array[String](["Concentration", "Elemental", "Weapon"])
base_cast = "Draw elemental force into a weapon. The weapon gains an elemental expression while the spell lasts. - Earth: The weapon strikes with crushing force and can Stun. - Air: The weapon becomes lighter and quicker in motion. - Water: The weapon gains freezing force and can apply Freeze. - Fire: The weapon gains Fire and can apply Burning."
id = 1
_name = "Imbue Elements"
short_description = "Imbue a weapon with elemental force."
long_description = "Draw elemental force into a weapon. The weapon gains an elemental expression while the spell lasts. Earth causes crushing force and can Stun. Air makes the weapon lighter and quicker in motion. Water grants freezing force and can apply Freeze. Fire grants Fire and can apply Burning."

