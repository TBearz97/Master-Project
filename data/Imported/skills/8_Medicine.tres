_name = "Medicine"
short_description = "The art of healing and preserving life."
long_description = "Medicine is the knowledge of flesh and spirit, of how wounds may be closed and ailments eased. It is the healer’s craft, restoring strength where it has faltered and warding off the grasp of death itself."
