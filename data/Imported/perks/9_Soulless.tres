[resource]
script = ExtResource("1_8esh8")
category = "Race"
requirement_text = "Husk-Folk only"
id = 9
_name = "Soulless"
short_description = "You are immune to necrotic damage and instead heal the full amount it would have dealt."
long_description = "Though still fully living people, Husk-Folk have been touched by necrosis so deeply that it no longer harms them as it does others. You are immune to necrotic damage. Instead, you heal the full amount of necrotic damage that would have been inflicted upon you."
