_name = "Spellsword"
short_description = "Use a weapon as a casting focus and gain Mana on hit."
long_description = "Choose one weapon type you have Weapon Proficiency with. That weapon counts as a casting focus for you, and the first time each round you deal damage with it you gain 1 Mana."
