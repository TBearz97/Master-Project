_name = "We Endure"
short_description = "During each full rest, heal one additional Injury or reduce one disease duration by an additional step."
long_description = "Life is harsh, and your people are shaped by enduring it. During each full rest, you may either heal one additional Injury or reduce the duration of one disease by an additional step."
