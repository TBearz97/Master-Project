_name = "Spy"
short_description = "Operative trained in secrecy, infiltration, and deception."
long_description = "You worked in the shadows, gathering information, manipulating situations, and blending into environments where you did not belong. Whether for a nation or private interest, your life revolved around secrecy and calculated risk."
