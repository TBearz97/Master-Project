_name = "Insight"
short_description = "The ability to read truth in others."
long_description = "Insight is the quiet observation of subtle gestures, unspoken words, and hidden motives. It is the wisdom to look beyond appearances, discerning intent from shadow and sincerity from deceit."

[sub_resource type="Resource" id="Resource_tayhs"]
script = ExtResource("3_gtclr")
max_rank = 10
id = 11
_name = "Society"
short_description = "The understanding of order, law, and custom."
long_description = "Society is the study of how people live together: their structures of power, their traditions, their spoken and unspoken rules. One skilled in society can navigate courts and markets alike, finding their place among folk of every station."

[resource]
script = ExtResource("2_otvx0")
