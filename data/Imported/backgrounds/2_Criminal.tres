_name = "Stealth"
short_description = "The shadow’s embrace, unseen and unheard."
long_description = "Stealth is the skill of moving in silence, slipping past notice, and striking unseen. It is patience, precision, and the discipline to become part of the darkness itself."

[sub_resource type="Resource" id="Resource_4nqnc"]
script = ExtResource("3_vb0w5")
max_rank = 10
id = 10
_name = "Sleight of Hand"
short_description = "The art of swift, subtle fingers."
long_description = "Sleight of hand is dexterity made invisible — a coin vanished, a purse lifted, a dagger drawn before the eye can follow. It is trickery and finesse, both performance and deception."

