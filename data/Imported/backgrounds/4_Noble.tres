[sub_resource type="Resource" id="Resource_3gxjt"]
script = ExtResource("1_wla4d")
category = "Background"
requirement_text = "Noble only"
id = 24
_name = "Courtly Privilege"
short_description = "Status opens doors in civilized places."
long_description = "You are accustomed to status, ceremony, and access. In appropriate civilized settings, you can secure basic hospitality or an audience that others might need to work harder to obtain."

[sub_resource type="Resource" id="Resource_tayhs"]
script = ExtResource("3_pi0e3")
max_rank = 10
id = 11
_name = "Society"
short_description = "The understanding of order, law, and custom."
long_description = "Society is the study of how people live together: their structures of power, their traditions, their spoken and unspoken rules. One skilled in society can navigate courts and markets alike, finding their place among folk of every station."

[sub_resource type="Resource" id="Resource_edehd"]
script = ExtResource("3_pi0e3")
max_rank = 10
id = 3
_name = "Command"
short_description = "The voice that moves others to act."
long_description = "Command is the force of presence that rallies companions and bends wills to a common cause. It is found in the calm orders given in battle, the unshakable confidence that inspires courage, and the steady gaze that compels obedience without question."

[resource]
script = ExtResource("2_nu3n5")
perk = SubResource("Resource_3gxjt")
skill_1 = SubResource("Resource_tayhs")
skill_2 = SubResource("Resource_edehd")
id = 4
_name = "Noble"
short_description = "Individual of high birth or elevated social standing."
long_description = "You were raised among wealth, influence, and expectation, or rose into such a position through effort or circumstance. You understand power structures, social etiquette, and the responsibilities—and privileges—that come with status."
