id = 4
_name = "Craft"
short_description = "The shaping of raw material into lasting form."
long_description = "Craft is the skill of hands guided by knowledge, turning wood, stone, or steel into tools, weapons, and works of art. It is patience, precision, and creativity bound together, leaving behind works that endure beyond their maker’s lifetime."

[sub_resource type="Resource" id="Resource_nw44m"]
script = ExtResource("3_iloir")
max_rank = 10
id = 2
_name = "Athletics"
short_description = "The measure of strength, speed, and stamina in motion."
long_description = "Athletics is the discipline of the body pushed to its limits — running, climbing, leaping, and enduring trials that test both muscle and breath. It is the difference between faltering on the field and pressing forward with unyielding vigor."

[resource]
script = ExtResource("2_mcjs4")
