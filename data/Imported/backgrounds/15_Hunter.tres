[sub_resource type="Resource" id="Resource_ua1t7"]
script = ExtResource("3_k8ain")
max_rank = 10
id = 1
_name = "Animal Handling"
short_description = "The bond between mortal and beast."
long_description = "Animal handling is the art of trust and instinct, guiding creatures through patience rather than force. It is the steady hand that calms a frightened steed, the subtle command that turns a hound against its quarry, and the quiet respect that earns loyalty from claw and fang alike."

[sub_resource type="Resource" id="Resource_qh5pf"]
script = ExtResource("3_k8ain")
max_rank = 10
id = 14
_name = "Survival"
short_description = "The knowledge to endure the wilds."
long_description = "Survival is the understanding of nature’s dangers and gifts — how to find water, build shelter, track game, and weather storm or famine. It is the art of living where the land itself may seek to claim you."

[resource]
script = ExtResource("2_m6a7b")
perk = SubResource("Resource_p6kx0")
skill_1 = SubResource("Resource_ua1t7")
skill_2 = SubResource("Resource_qh5pf")
id = 15
_name = "Hunter"
short_description = "Tracker and provider attuned to the rhythms of nature."
long_description = "You survived by observing, tracking, and harvesting from the wild. Patience, awareness, and respect for nature shaped your way of life."
