[sub_resource type="Resource" id="Resource_p45st"]
script = ExtResource("1_rmkjk")
category = "Background"
requirement_text = "Soldier only"
id = 21
_name = "Military Training"
short_description = "Gain 1 additional movement-only AP each turn in combat."
long_description = "During combat, you gain 1 additional AP each turn that can only be spent on movement."

[sub_resource type="Resource" id="Resource_nw44m"]
script = ExtResource("3_aahkt")
max_rank = 10
id = 2
_name = "Athletics"
short_description = "The measure of strength, speed, and stamina in motion."
long_description = "Athletics is the discipline of the body pushed to its limits — running, climbing, leaping, and enduring trials that test both muscle and breath. It is the difference between faltering on the field and pressing forward with unyielding vigor."

[sub_resource type="Resource" id="Resource_qh5pf"]
script = ExtResource("3_aahkt")
max_rank = 10
id = 14
_name = "Survival"
short_description = "The knowledge to endure the wilds."
long_description = "Survival is the understanding of nature’s dangers and gifts — how to find water, build shelter, track game, and weather storm or famine. It is the art of living where the land itself may seek to claim you."

[resource]
script = ExtResource("2_keabw")
perk = SubResource("Resource_p45st")
skill_1 = SubResource("Resource_nw44m")
skill_2 = SubResource("Resource_qh5pf")
id = 1
_name = "Soldier"
short_description = "Disciplined fighter shaped by military service."
long_description = "You served in a structured military force where discipline, hierarchy, and training defined your life. You learned to operate under pressure, follow orders, and lead when required. Even after leaving service, that conditioning remains, and you may still feel the pull of duty when called upon."
