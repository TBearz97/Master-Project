[sub_resource type="Resource" id="Resource_1e8n2"]
script = ExtResource("1_02w6h")
id = 9
_name = "Potency"
short_description = "Enhances effect strength and duration."
long_description = "Potency enhances the strength, effectiveness, and sometimes duration of abilities, spells, and effects applied to targets."

[sub_resource type="Resource" id="Resource_i2hsa"]
script = ExtResource("1_02w6h")
id = 10
_name = "Bestiary Progression"
short_description = "Improves knowledge of creatures."
long_description = "Bestiary Progression tracks knowledge and understanding of creatures, improving effectiveness when dealing with known enemy types."

[resource]
script = ExtResource("2_nvutp")
modifier_1 = SubResource("Resource_1e8n2")
modifier_1_expression = "x + 2"
modifier_2 = SubResource("Resource_i2hsa")
modifier_2_expression = "x * 3"
min_value = 1
max_value = 10
id = 5
_name = "Intelligence"
short_description = "Represents reasoning and analytical ability."
long_description = "Intelligence governs a character’s capacity for logic, learning, and understanding complex systems. It enhances awareness of enemies and the environment, improving bestiary knowledge and analysis. High Intelligence also refines control over magical and tactical effects, increasing the duration of buffs and debuffs applied in combat."
