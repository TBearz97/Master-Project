[sub_resource type="Resource" id="Resource_r6c33"]
script = ExtResource("1_51e24")
id = 2
_name = "Zealous"
short_description = "Magic fueled by belief and devotion."
long_description = "Magic shaped by belief, devotion, conviction, and the powers that answer them."

[resource]
script = ExtResource("2_lfwnc")
school = SubResource("Resource_r6c33")
tags = Array[String](["Lasting", "Zealous"])
base_cast = "Summon your weapon of faith. What form this weapon takes is determined by your belief. Unlike Conjure Weapon, you do not freely choose the weapon at cast time. It is the sacred weapon associated with your conviction, oath, or divine allegiance. While summoned, the weapon functions like a normal weapon from the equipment lists, but counts as magical. The exact weapon granted depends on your belief. Some beliefs grant only one sacred weapon, while others allow a small set of valid sacred weapons."
id = 34
_name = "Weapon of Faith"
short_description = "Summon your sacred weapon."
long_description = "Summon your weapon of faith. What form this weapon takes is determined by your belief. Unlike Conjure Weapon, you do not freely choose the weapon at cast time. It is the sacred weapon associated with your conviction, oath, or divine allegiance. While summoned, the weapon functions like a normal weapon from the equipment lists, but counts as magical. The exact weapon granted depends on your belief. Some beliefs grant only one sacred weapon, while others allow a small set of valid sacred weapons."
