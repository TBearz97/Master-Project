id = 5
_name = "Halfling"
short_description = "Small, agile people known for charm and resourcefulness."
long_description = "Halflings are quick, clever, and naturally sociable. Their size encourages agility and adaptability, allowing them to navigate the world through wit and cooperation rather than force. They value comfort, companionship, and clever solutions to life’s challenges."
