_name = "We Endure"
short_description = "During each full rest, heal one additional Injury or reduce one disease duration by an additional step."
long_description = "Life is harsh, and your people are shaped by enduring it. During each full rest, you may either heal one additional Injury or reduce the duration of one disease by an additional step."

[resource]
script = ExtResource("2_evhu8")
perk = SubResource("Resource_4ra5h")
id = 8
_name = "Orc"
short_description = "Resilient people defined by toughness and determination."
long_description = "Orcs are known for their physical durability and unyielding nature. Their culture values strength, endurance, and the ability to persevere through hardship. Whether in conflict or survival, they are relentless, often pushing forward where others would falter."
