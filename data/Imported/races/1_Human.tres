_name = "Human"
short_description = "Adaptable and cooperative people who thrive in diverse roles."
long_description = "Humans are known for their flexibility, ambition, and strong sense of community. They build connections easily and often succeed through cooperation and persistence. Rather than excelling in a single extreme, their strength lies in their ability to adapt, support others, and find opportunity in changing circumstances."
