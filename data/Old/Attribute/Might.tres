[gd_resource type="Resource" script_class="Attribute" load_steps=2 format=3]

[ext_resource type="Script" path="res://content/codex/character_options/attribute.gd" id="1_wmulo"]

[resource]
script = ExtResource("1_wmulo")
bonus_1_prefix = "Damage & Healing:"
bonus_2_prefix = "Carry Weight:"
bonus_1_expression = "(x -  5) * 7"
bonus_2_expression = "(x * 10) + 45"
bonus_1_suffix = "%"
bonus_2_suffix = "kg"
_name = "Might"
short_description = "Represents physical and spiritual strength."
long_description = "Might measures the character’s raw physical and inner power. It influences both physical and magical damage as well as the effectiveness of healing abilities. Characters with higher Might deal and heal more damage and can carry heavier loads."
